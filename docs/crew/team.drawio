<mxfile host="app.diagrams.net" agent="team_diagram.py" version="24.7.7" type="device">
  <diagram id="page1" name="1 · Team and ownership">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="2039" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="p1_t_title" value="&lt;div style=&quot;font-size:22px;&quot;&gt;&lt;b&gt;The crew — who does what&lt;/b&gt;&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontColor=#1a1a1a;strokeWidth=1.2;align=left;verticalAlign=top;spacing=0;fontFamily=Inter;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1400" height="34" as="geometry" /></mxCell>
        <mxCell id="p1_t_sub" value="&lt;div style=&quot;font-size:11px;color:#666666;&quot;&gt;Generated by integrations/crew/team_diagram.py from plugins/, the crew-workflow skill and team.json — edit those, not this file.&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontColor=#666666;strokeWidth=1.2;align=left;verticalAlign=top;spacing=0;fontFamily=Inter;" vertex="1" parent="1"><mxGeometry x="40" y="56" width="1500" height="24" as="geometry" /></mxCell>
        <mxCell id="p1_lead_captain" value="&lt;div style=&quot;font-size:16px;&quot;&gt;&lt;b&gt;Captain&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:11px;color:#555555;&quot;&gt;&lt;i&gt;You — the human&lt;/i&gt;&lt;/div&gt;&lt;div style=&quot;font-size:9px;color:#777777;margin-top:6px;&quot;&gt;&lt;b&gt;DOES&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:10.5px;&quot;&gt;• Sets the intent for every task&lt;/div&gt;&lt;div style=&quot;font-size:10.5px;&quot;&gt;• Answers the questions the crew stops on&lt;/div&gt;&lt;div style=&quot;font-size:10.5px;&quot;&gt;• Adds every repository secret (gh secret set) and creates hosting accounts; no crew role handles a secret value&lt;/div&gt;&lt;div style=&quot;font-size:10.5px;&quot;&gt;• Approves every ticket or board write before it is made, and anything irreversible: deleting a ticket, creating a board&lt;/div&gt;&lt;div style=&quot;font-size:10.5px;&quot;&gt;• Reviews the code in In approval and moves the card to QA; merges PRs&lt;/div&gt;&lt;div style=&quot;font-size:9px;color:#777777;margin-top:6px;&quot;&gt;&lt;b&gt;OWNS&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:10.5px;&quot;&gt;• Product intent and priorities&lt;/div&gt;&lt;div style=&quot;font-size:10.5px;&quot;&gt;• Merge decisions&lt;/div&gt;&lt;div style=&quot;font-size:10.5px;&quot;&gt;• Installing the crew plugins (apkit install)&lt;/div&gt;&lt;div style=&quot;font-size:10.5px;&quot;&gt;• Captain-only plugins (listed below)&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#fff4e0;strokeColor=#d08a00;fontColor=#5c3d00;strokeWidth=1.6;align=left;verticalAlign=top;spacing=12;fontFamily=Inter;" vertex="1" parent="1"><mxGeometry x="40" y="100" width="420" height="267" as="geometry" /></mxCell>
        <mxCell id="p1_integ" value="&lt;div style=&quot;font-size:14px;&quot;&gt;&lt;b&gt;Crew workflow&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:10px;color:#555555;&quot;&gt;&lt;font face=&quot;JetBrains Mono&quot;&gt;crew plugin: SessionStart hook + crew-workflow skill&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;font-size:9px;color:#777777;margin-top:6px;&quot;&gt;&lt;b&gt;HOW A SESSION GETS IT&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:10.5px;&quot;&gt;• A repository with a crew board: every session is pointed at the crew-workflow skill&lt;/div&gt;&lt;div style=&quot;font-size:10.5px;&quot;&gt;• No crew board: the first reply offers /crew:create-board (a no is remembered)&lt;/div&gt;&lt;div style=&quot;font-size:10.5px;&quot;&gt;• Install the crew: python -m tools.apkit install &amp;lt;plugin&amp;gt; --target claude-code&lt;/div&gt;&lt;div style=&quot;font-size:9px;color:#777777;margin-top:6px;&quot;&gt;&lt;b&gt;RULES EVERY SESSION KEEPS (FROM THE SKILL)&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:10.5px;&quot;&gt;• Every step runs through its crew command&lt;/div&gt;&lt;div style=&quot;font-size:10.5px;&quot;&gt;• Never ask from In Definition to In approval.&lt;/div&gt;&lt;div style=&quot;font-size:10.5px;&quot;&gt;• Never skip a column.&lt;/div&gt;&lt;div style=&quot;font-size:10.5px;&quot;&gt;• Stop at In approval.&lt;/div&gt;&lt;div style=&quot;font-size:10.5px;&quot;&gt;• A card the Captain moves to QA starts QA.&lt;/div&gt;&lt;div style=&quot;font-size:10.5px;&quot;&gt;• Stop at Ready for Merge.&lt;/div&gt;&lt;div style=&quot;font-size:10.5px;&quot;&gt;• No PR without a ticket, and never a second ticket for the same work.&lt;/div&gt;&lt;div style=&quot;font-size:10.5px;&quot;&gt;• When a step cannot be settled, ask the Captain.&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#fafafa;strokeColor=#c8c8c8;fontColor=#333333;strokeWidth=1.2;align=left;verticalAlign=top;spacing=12;fontFamily=Inter;" vertex="1" parent="1"><mxGeometry x="580" y="100" width="520" height="249" as="geometry" /></mxCell>
        <mxCell id="p1_crew_box" value="&lt;div style=&quot;font-size:14px;&quot;&gt;&lt;b&gt;Crew — 7 crew plugins (team.json crew), one Claude Code session leads them&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:10.5px;color:#3a5a46;&quot;&gt;The crew runs inside one Claude Code session with all crew plugins loaded; the crew-workflow skill picks the crew command for each step. A role is the plugin the skill routes that kind of work to, so on UI work the session plays Designer, then Developer, then Designer again. Developer and Scrum Master carry the full ticket-management skill: they create, edit and close tickets and move board cards, and delete one only when the Captain names it. QA Engineer creates and edits tickets, labelling each one it creates &amp;quot;QA testing&amp;quot;. Code Reviewer only moves the card of a PR it reviewed: back to In progress, or on to In approval (QA when labelled skip_approval). The Captain moves a card from In approval to QA after reviewing the code. Designer, DevOps Engineer and Code Reviewer propose tickets, which a developer or scrum-master step files once the Captain agrees.&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f5fbf7;strokeColor=#2e8b57;fontColor=#174d30;strokeWidth=1.2;align=left;verticalAlign=top;spacing=14;fontFamily=Inter;dashed=1;container=0;" vertex="1" parent="1"><mxGeometry x="40" y="437" width="1420" height="1393" as="geometry" /></mxCell>
        <mxCell id="p1_crew_developer" value="&lt;div style=&quot;font-size:15px;&quot;&gt;&lt;b&gt;Developer&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:10px;color:#555555;&quot;&gt;developer plugin · v0.7.1 · claude-opus-5-5&lt;/div&gt;&lt;div style=&quot;font-size:9px;color:#777777;margin-top:6px;&quot;&gt;&lt;b&gt;ROUTED HERE WHEN&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:10.5px;&quot;&gt;• Feature, ticket or change&lt;/div&gt;&lt;div style=&quot;font-size:10.5px;&quot;&gt;• Restructure without behaviour change&lt;/div&gt;&lt;div style=&quot;font-size:10.5px;&quot;&gt;• Bug, failing or flaky test, wrong output&lt;/div&gt;&lt;div style=&quot;font-size:10.5px;&quot;&gt;• Known-good regression&lt;/div&gt;&lt;div style=&quot;font-size:10.5px;&quot;&gt;• Merge conflicts on a PR&lt;/div&gt;&lt;div style=&quot;font-size:10.5px;&quot;&gt;• Before pushing&lt;/div&gt;&lt;div style=&quot;font-size:10.5px;&quot;&gt;• Code review&lt;/div&gt;&lt;div style=&quot;font-size:9px;color:#777777;margin-top:6px;&quot;&gt;&lt;b&gt;COMMANDS&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:10.5px;&quot;&gt;&lt;font face=&quot;JetBrains Mono&quot;&gt;/developer:bisect&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;font-size:10.5px;&quot;&gt;&lt;font face=&quot;JetBrains Mono&quot;&gt;/developer:diagnose&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;font-size:10.5px;&quot;&gt;&lt;font face=&quot;JetBrains Mono&quot;&gt;/developer:fix&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;font-size:10.5px;&quot;&gt;&lt;font face=&quot;JetBrains Mono&quot;&gt;/developer:implement&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;font-size:10.5px;&quot;&gt;&lt;font face=&quot;JetBrains Mono&quot;&gt;/developer:refactor&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;font-size:10.5px;&quot;&gt;&lt;font face=&quot;JetBrains Mono&quot;&gt;/developer:resolve-conflicts&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;font-size:10.5px;&quot;&gt;&lt;font face=&quot;JetBrains Mono&quot;&gt;/developer:ship&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;font-size:10.5px;&quot;&gt;&lt;font face=&quot;JetBrains Mono&quot;&gt;/developer:tdd&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;font-size:10.5px;&quot;&gt;&lt;font face=&quot;JetBrains Mono&quot;&gt;/developer:verify&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;font-size:9px;color:#777777;margin-top:6px;&quot;&gt;&lt;b&gt;SUBAGENT&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:10.5px;&quot;&gt;&lt;font face=&quot;JetBrains Mono&quot;&gt;implementer (claude-opus-5-5)&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;font-size:10.5px;&quot;&gt;&lt;font face=&quot;JetBrains Mono&quot;&gt;investigator (claude-opus-5-5)&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;font-size:9px;color:#777777;margin-top:6px;&quot;&gt;&lt;b&gt;SKILLS&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:10.5px;&quot;&gt;&lt;font face=&quot;JetBrains Mono&quot;&gt;feature-implementation&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;font-size:10.5px;&quot;&gt;&lt;font face=&quot;JetBrains Mono&quot;&gt;merge-conflict-resolution&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;font-size:10.5px;&quot;&gt;&lt;font face=&quot;JetBrains Mono&quot;&gt;regression-triage&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;font-size:10.5px;&quot;&gt;&lt;font face=&quot;JetBrains Mono&quot;&gt;root-cause-analysis&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;font-size:10.5px;&quot;&gt;&lt;font face=&quot;JetBrains Mono&quot;&gt;safe-refactoring&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;font-size:10.5px;&quot;&gt;&lt;font face=&quot;JetBrains Mono&quot;&gt;ship-change&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;font-size:10.5px;&quot;&gt;&lt;font face=&quot;JetBrains Mono&quot;&gt;ticket-management (shared)&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;font-size:10.5px;&quot;&gt;&lt;font face=&quot;JetBrains Mono&quot;&gt;test-driven-development (shared)&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;font-size:9px;color:#777777;margin-top:6px;&quot;&gt;&lt;b&gt;MCP TOOLS&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:10.5px;&quot;&gt;&lt;font face=&quot;JetBrains Mono&quot;&gt;verify_commands, find_callers, dev_playbook, repro_command, change_history, bug_playbook&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;font-size:9px;color:#777777;margin-top:6px;&quot;&gt;&lt;b&gt;HOOKS&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:10.5px;&quot;&gt;&lt;font face=&quot;JetBrains Mono&quot;&gt;SessionStart → dev_context.py&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;font-size:10.5px;&quot;&gt;&lt;font face=&quot;JetBrains Mono&quot;&gt;PostToolUse(Write|Edit) → symptom_suppression_check.py&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;font-size:9px;color:#777777;margin-top:6px;&quot;&gt;&lt;b&gt;OWNS&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:10.5px;&quot;&gt;• Code changes, built in slices that stay green&lt;/div&gt;&lt;div style=&quot;font-size:10.5px;&quot;&gt;• Test-first slices in red-green-refactor cycles (/developer:implement, /developer:tdd)&lt;/div&gt;&lt;div style=&quot;font-size:10.5px;&quot;&gt;• A proved root cause and a failing-first test before any bug fix (/developer:diagnose, /developer:fix)&lt;/div&gt;&lt;div style=&quot;font-size:10.5px;&quot;&gt;• The first bad commit of a regression (/developer:bisect)&lt;/div&gt;&lt;div style=&quot;font-size:10.5px;&quot;&gt;• Repo checks passing before push&lt;/div&gt;&lt;div style=&quot;font-size:10.5px;&quot;&gt;• Branch, PR and the ticket&amp;#x27;s card to In review (/developer:ship)&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#e8f6ee;strokeColor=#2e8b57;fontColor=#174d30;strokeWidth=1.2;align=left;verticalAlign=top;spacing=12;fontFamily=Inter;" vertex="1" parent="1"><mxGeometry x="60" y="507" width="330" height="780" as="geometry" /></mxCell>
        <mxCell id="p1_crew_designer" value="&lt;div style=&quot;font-size:15px;&quot;&gt;&lt;b&gt;UI/UX Designer&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:10px;color:#555555;&quot;&gt;designer plugin · v0.1.1 · claude-opus-5-5, claude-sonnet-5-5&lt;/div&gt;&lt;div style=&quot;font-size:9px;color:#777777;margin-top:6px;&quot;&gt;&lt;b&gt;ROUTED HERE WHEN&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:10.5px;&quot;&gt;• New or changed UI&lt;/div&gt;&lt;div style=&quot;font-size:9px;color:#777777;margin-top:6px;&quot;&gt;&lt;b&gt;COMMANDS&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:10.5px;&quot;&gt;&lt;font face=&quot;JetBrains Mono&quot;&gt;/designer:review&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;font-size:10.5px;&quot;&gt;&lt;font face=&quot;JetBrains Mono&quot;&gt;/designer:spec&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;font-size:9px;color:#777777;margin-top:6px;&quot;&gt;&lt;b&gt;SUBAGENT&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:10.5px;&quot;&gt;&lt;font face=&quot;JetBrains Mono&quot;&gt;first-time-user (claude-sonnet-5-5)&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;font-size:9px;color:#777777;margin-top:6px;&quot;&gt;&lt;b&gt;SKILLS&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:10.5px;&quot;&gt;&lt;font face=&quot;JetBrains Mono&quot;&gt;design-spec&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;font-size:10.5px;&quot;&gt;&lt;font face=&quot;JetBrains Mono&quot;&gt;ux-review&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;font-size:9px;color:#777777;margin-top:6px;&quot;&gt;&lt;b&gt;OWNS&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:10.5px;&quot;&gt;• Design spec before UI is built: flow, every state, layout, copy, accessibility&lt;/div&gt;&lt;div style=&quot;font-size:10.5px;&quot;&gt;• UX review of built UI: usability, WCAG 2.2 AA, design-system consistency&lt;/div&gt;&lt;div style=&quot;font-size:10.5px;&quot;&gt;• A first-time-user walk-through of each new flow&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#e8f6ee;strokeColor=#2e8b57;fontColor=#174d30;strokeWidth=1.2;align=left;verticalAlign=top;spacing=12;fontFamily=Inter;" vertex="1" parent="1"><mxGeometry x="410" y="507" width="330" height="780" as="geometry" /></mxCell>
        <mxCell id="p1_crew_crew" value="&lt;div style=&quot;font-size:15px;&quot;&gt;&lt;b&gt;Crew workflow&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:10px;color:#555555;&quot;&gt;crew plugin · v0.4.0 · claude-sonnet-5-5&lt;/div&gt;&lt;div style=&quot;font-size:9px;color:#777777;margin-top:6px;&quot;&gt;&lt;b&gt;ROUTED HERE WHEN&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:10.5px;&quot;&gt;• New project board&lt;/div&gt;&lt;div style=&quot;font-size:9px;color:#777777;margin-top:6px;&quot;&gt;&lt;b&gt;COMMANDS&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:10.5px;&quot;&gt;&lt;font face=&quot;JetBrains Mono&quot;&gt;/crew:create-board&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;font-size:9px;color:#777777;margin-top:6px;&quot;&gt;&lt;b&gt;SKILLS&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:10.5px;&quot;&gt;&lt;font face=&quot;JetBrains Mono&quot;&gt;crew-workflow (shared)&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;font-size:10.5px;&quot;&gt;&lt;font face=&quot;JetBrains Mono&quot;&gt;board-setup (shared)&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;font-size:10.5px;&quot;&gt;&lt;font face=&quot;JetBrains Mono&quot;&gt;ticket-management (shared)&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;font-size:9px;color:#777777;margin-top:6px;&quot;&gt;&lt;b&gt;HOOKS&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:10.5px;&quot;&gt;&lt;font face=&quot;JetBrains Mono&quot;&gt;SessionStart → crew_context.py&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;font-size:10.5px;&quot;&gt;&lt;font face=&quot;JetBrains Mono&quot;&gt;UserPromptSubmit → crew_context.py&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;font-size:9px;color:#777777;margin-top:6px;&quot;&gt;&lt;b&gt;OWNS&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:10.5px;&quot;&gt;• The crew&amp;#x27;s process in interactive sessions: the crew-workflow skill and the session-start hook that points a session at it&lt;/div&gt;&lt;div style=&quot;font-size:10.5px;&quot;&gt;• Creating the project board and its columns (/crew:create-board)&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#e8f6ee;strokeColor=#2e8b57;fontColor=#174d30;strokeWidth=1.2;align=left;verticalAlign=top;spacing=12;fontFamily=Inter;" vertex="1" parent="1"><mxGeometry x="760" y="507" width="330" height="780" as="geometry" /></mxCell>
        <mxCell id="p1_crew_scrum-master" value="&lt;div style=&quot;font-size:15px;&quot;&gt;&lt;b&gt;Scrum Master&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:10px;color:#555555;&quot;&gt;scrum-master plugin · v0.6.0 · claude-sonnet-5-5&lt;/div&gt;&lt;div style=&quot;font-size:9px;color:#777777;margin-top:6px;&quot;&gt;&lt;b&gt;ROUTED HERE WHEN&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:10.5px;&quot;&gt;• Backlog grooming&lt;/div&gt;&lt;div style=&quot;font-size:10.5px;&quot;&gt;• Sprint planning&lt;/div&gt;&lt;div style=&quot;font-size:9px;color:#777777;margin-top:6px;&quot;&gt;&lt;b&gt;COMMANDS&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:10.5px;&quot;&gt;&lt;font face=&quot;JetBrains Mono&quot;&gt;/scrum-master:backlog-health&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;font-size:10.5px;&quot;&gt;&lt;font face=&quot;JetBrains Mono&quot;&gt;/scrum-master:plan-sprint&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;font-size:10.5px;&quot;&gt;&lt;font face=&quot;JetBrains Mono&quot;&gt;/scrum-master:refine&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;font-size:9px;color:#777777;margin-top:6px;&quot;&gt;&lt;b&gt;SUBAGENT&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:10.5px;&quot;&gt;&lt;font face=&quot;JetBrains Mono&quot;&gt;story-splitter (claude-sonnet-5-5)&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;font-size:9px;color:#777777;margin-top:6px;&quot;&gt;&lt;b&gt;SKILLS&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:10.5px;&quot;&gt;&lt;font face=&quot;JetBrains Mono&quot;&gt;backlog-refinement&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;font-size:10.5px;&quot;&gt;&lt;font face=&quot;JetBrains Mono&quot;&gt;sprint-planning&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;font-size:10.5px;&quot;&gt;&lt;font face=&quot;JetBrains Mono&quot;&gt;ticket-management (shared)&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;font-size:9px;color:#777777;margin-top:6px;&quot;&gt;&lt;b&gt;MCP TOOLS&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:10.5px;&quot;&gt;&lt;font face=&quot;JetBrains Mono&quot;&gt;backlog, readiness_check, scrum_checklist&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;font-size:9px;color:#777777;margin-top:6px;&quot;&gt;&lt;b&gt;HOOKS&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:10.5px;&quot;&gt;&lt;font face=&quot;JetBrains Mono&quot;&gt;SessionStart → sprint_context.py&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;font-size:9px;color:#777777;margin-top:6px;&quot;&gt;&lt;b&gt;OWNS&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:10.5px;&quot;&gt;• Backlog readiness: value, acceptance criteria, size&lt;/div&gt;&lt;div style=&quot;font-size:10.5px;&quot;&gt;• Splitting items sized 13+ into vertical slices&lt;/div&gt;&lt;div style=&quot;font-size:10.5px;&quot;&gt;• Filing the backlog it refines (tickets.py batch, rerunnable)&lt;/div&gt;&lt;div style=&quot;font-size:10.5px;&quot;&gt;• Sprint goal, capacity and plan&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#e8f6ee;strokeColor=#2e8b57;fontColor=#174d30;strokeWidth=1.2;align=left;verticalAlign=top;spacing=12;fontFamily=Inter;" vertex="1" parent="1"><mxGeometry x="1110" y="507" width="330" height="780" as="geometry" /></mxCell>
        <mxCell id="p1_crew_qa" value="&lt;div style=&quot;font-size:15px;&quot;&gt;&lt;b&gt;QA Engineer&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:10px;color:#555555;&quot;&gt;qa plugin · v0.7.2 · claude-sonnet-5-5&lt;/div&gt;&lt;div style=&quot;font-size:9px;color:#777777;margin-top:6px;&quot;&gt;&lt;b&gt;ROUTED HERE WHEN&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:10.5px;&quot;&gt;• Ticket with acceptance criteria&lt;/div&gt;&lt;div style=&quot;font-size:10.5px;&quot;&gt;• Once the card is in QA (never from In review or In approval)&lt;/div&gt;&lt;div style=&quot;font-size:10.5px;&quot;&gt;• Bug found while testing&lt;/div&gt;&lt;div style=&quot;font-size:9px;color:#777777;margin-top:6px;&quot;&gt;&lt;b&gt;COMMANDS&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:10.5px;&quot;&gt;&lt;font face=&quot;JetBrains Mono&quot;&gt;/qa:bug&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;font-size:10.5px;&quot;&gt;&lt;font face=&quot;JetBrains Mono&quot;&gt;/qa:plan&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;font-size:10.5px;&quot;&gt;&lt;font face=&quot;JetBrains Mono&quot;&gt;/qa:verify&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;font-size:9px;color:#777777;margin-top:6px;&quot;&gt;&lt;b&gt;SUBAGENT&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:10.5px;&quot;&gt;&lt;font face=&quot;JetBrains Mono&quot;&gt;acceptance-checker (claude-sonnet-5-5)&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;font-size:9px;color:#777777;margin-top:6px;&quot;&gt;&lt;b&gt;SKILLS&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:10.5px;&quot;&gt;&lt;font face=&quot;JetBrains Mono&quot;&gt;acceptance-testing&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;font-size:10.5px;&quot;&gt;&lt;font face=&quot;JetBrains Mono&quot;&gt;bug-reporting&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;font-size:10.5px;&quot;&gt;&lt;font face=&quot;JetBrains Mono&quot;&gt;test-planning&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;font-size:10.5px;&quot;&gt;&lt;font face=&quot;JetBrains Mono&quot;&gt;ticket-management (shared)&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;font-size:10.5px;&quot;&gt;&lt;font face=&quot;JetBrains Mono&quot;&gt;preview-link (shared)&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;font-size:9px;color:#777777;margin-top:6px;&quot;&gt;&lt;b&gt;OWNS&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:10.5px;&quot;&gt;• A test plan from each ticket&amp;#x27;s acceptance criteria, before it is built&lt;/div&gt;&lt;div style=&quot;font-size:10.5px;&quot;&gt;• The accept / reject verdict on a built change, on the PR&amp;#x27;s head commit run locally (review links are paused; re-tested on a new commit), with evidence per criterion&lt;/div&gt;&lt;div style=&quot;font-size:10.5px;&quot;&gt;• Moving a verified ticket to Ready for Merge on accept (adding the column if missing) or back to In progress on reject, with a comment on what fails&lt;/div&gt;&lt;div style=&quot;font-size:10.5px;&quot;&gt;• Bug tickets for every failure, filed by QA and labelled &amp;quot;QA testing&amp;quot; (create and edit, never close or delete)&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#e8f6ee;strokeColor=#2e8b57;fontColor=#174d30;strokeWidth=1.2;align=left;verticalAlign=top;spacing=12;fontFamily=Inter;" vertex="1" parent="1"><mxGeometry x="60" y="1307" width="330" height="503" as="geometry" /></mxCell>
        <mxCell id="p1_crew_devops" value="&lt;div style=&quot;font-size:15px;&quot;&gt;&lt;b&gt;DevOps Engineer&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:10px;color:#555555;&quot;&gt;devops plugin · v0.3.1 · claude-opus-5-5, claude-sonnet-5-5&lt;/div&gt;&lt;div style=&quot;font-size:9px;color:#777777;margin-top:6px;&quot;&gt;&lt;b&gt;ROUTED HERE WHEN&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:10.5px;&quot;&gt;• CI/CD&lt;/div&gt;&lt;div style=&quot;font-size:10.5px;&quot;&gt;• Review links (PR previews) are paused&lt;/div&gt;&lt;div style=&quot;font-size:9px;color:#777777;margin-top:6px;&quot;&gt;&lt;b&gt;COMMANDS&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:10.5px;&quot;&gt;&lt;font face=&quot;JetBrains Mono&quot;&gt;/devops:ci&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;font-size:10.5px;&quot;&gt;&lt;font face=&quot;JetBrains Mono&quot;&gt;/devops:preview&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;font-size:10.5px;&quot;&gt;&lt;font face=&quot;JetBrains Mono&quot;&gt;/devops:triage&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;font-size:9px;color:#777777;margin-top:6px;&quot;&gt;&lt;b&gt;SKILLS&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:10.5px;&quot;&gt;&lt;font face=&quot;JetBrains Mono&quot;&gt;ci-setup&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;font-size:10.5px;&quot;&gt;&lt;font face=&quot;JetBrains Mono&quot;&gt;pipeline-triage&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;font-size:10.5px;&quot;&gt;&lt;font face=&quot;JetBrains Mono&quot;&gt;preview-environments&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;font-size:10.5px;&quot;&gt;&lt;font face=&quot;JetBrains Mono&quot;&gt;preview-link (shared)&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;font-size:9px;color:#777777;margin-top:6px;&quot;&gt;&lt;b&gt;OWNS&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:10.5px;&quot;&gt;• CI on GitHub Actions that runs each repo&amp;#x27;s own checks, proved by a green run on a real PR (/devops:ci)&lt;/div&gt;&lt;div style=&quot;font-size:10.5px;&quot;&gt;• Why a pipeline is red and whose fix it is: pipeline failures fixed, code failures handed to the developer (/devops:triage)&lt;/div&gt;&lt;div style=&quot;font-size:10.5px;&quot;&gt;• The secret names a workflow needs, for the Captain to add with gh secret set (never their values)&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#e8f6ee;strokeColor=#2e8b57;fontColor=#174d30;strokeWidth=1.2;align=left;verticalAlign=top;spacing=12;fontFamily=Inter;" vertex="1" parent="1"><mxGeometry x="410" y="1307" width="330" height="503" as="geometry" /></mxCell>
        <mxCell id="p1_crew_code-reviewer" value="&lt;div style=&quot;font-size:15px;&quot;&gt;&lt;b&gt;Code Reviewer&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:10px;color:#555555;&quot;&gt;code-reviewer plugin · v0.2.1 · claude-opus-5-5&lt;/div&gt;&lt;div style=&quot;font-size:9px;color:#777777;margin-top:6px;&quot;&gt;&lt;b&gt;ROUTED HERE WHEN&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:10.5px;&quot;&gt;• Code review&lt;/div&gt;&lt;div style=&quot;font-size:9px;color:#777777;margin-top:6px;&quot;&gt;&lt;b&gt;COMMANDS&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:10.5px;&quot;&gt;&lt;font face=&quot;JetBrains Mono&quot;&gt;/code-reviewer:review&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;font-size:9px;color:#777777;margin-top:6px;&quot;&gt;&lt;b&gt;SUBAGENT&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:10.5px;&quot;&gt;&lt;font face=&quot;JetBrains Mono&quot;&gt;reviewer (claude-opus-5-5)&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;font-size:9px;color:#777777;margin-top:6px;&quot;&gt;&lt;b&gt;SKILLS&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:10.5px;&quot;&gt;&lt;font face=&quot;JetBrains Mono&quot;&gt;pr-review&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;font-size:10.5px;&quot;&gt;&lt;font face=&quot;JetBrains Mono&quot;&gt;ticket-management (shared)&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;font-size:9px;color:#777777;margin-top:6px;&quot;&gt;&lt;b&gt;OWNS&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:10.5px;&quot;&gt;• A fresh-context review of every PR the developer ships, before QA: correctness and tests always; security, performance and accessibility when the diff touches them (/code-reviewer:review)&lt;/div&gt;&lt;div style=&quot;font-size:10.5px;&quot;&gt;• Findings that each carry a concrete failure scenario, posted as one PR review with an approve / request-changes verdict by fixed rules&lt;/div&gt;&lt;div style=&quot;font-size:10.5px;&quot;&gt;• On request changes, moving the ticket&amp;#x27;s card back to In progress; on approve, moving it to In approval for the Captain&amp;#x27;s review, or straight to QA when the ticket is labelled skip_approval&lt;/div&gt;&lt;div style=&quot;font-size:10.5px;&quot;&gt;• A full re-review of the new head after every fix push (never pushes code, never files tickets)&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#e8f6ee;strokeColor=#2e8b57;fontColor=#174d30;strokeWidth=1.2;align=left;verticalAlign=top;spacing=12;fontFamily=Inter;" vertex="1" parent="1"><mxGeometry x="760" y="1307" width="330" height="503" as="geometry" /></mxCell>
        <mxCell id="p1_e_ccrew" value="intent, approvals" style="edgeStyle=none;html=1;endArrow=block;endFill=1;strokeColor=#d08a00;strokeWidth=1.4;fontSize=10;fontColor=#333333;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="180" y="367" as="sourcePoint" /><mxPoint x="180" y="437" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="p1_e_crewc" value="questions, results, stops" style="edgeStyle=none;html=1;endArrow=block;endFill=1;strokeColor=#2e8b57;strokeWidth=1.4;fontSize=10;fontColor=#333333;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="340" y="437" as="sourcePoint" /><mxPoint x="340" y="367" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="p1_e_integ" value="routes every step" style="edgeStyle=none;html=1;endArrow=block;endFill=1;strokeColor=#888888;strokeWidth=1.4;fontSize=10;fontColor=#333333;labelBackgroundColor=#ffffff;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="840" y="349" as="sourcePoint" /><mxPoint x="840" y="437" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="p1_captain_only" value="&lt;div style=&quot;font-size:13px;&quot;&gt;&lt;b&gt;Captain-only plugins&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:10px;color:#555555;&quot;&gt;Installed for your own sessions; the crew-workflow skill routes no ticket work to them.&lt;/div&gt;&lt;div style=&quot;font-size:9px;color:#777777;margin-top:6px;&quot;&gt;&lt;b&gt;PLUGINS&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:10.5px;&quot;&gt;&lt;font face=&quot;JetBrains Mono&quot;&gt;notes&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;font-size:10.5px;&quot;&gt;&lt;font face=&quot;JetBrains Mono&quot;&gt;plugin-developer&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;font-size:10.5px;&quot;&gt;&lt;font face=&quot;JetBrains Mono&quot;&gt;skill-trainer&lt;/font&gt;&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#fff4e0;strokeColor=#d08a00;fontColor=#5c3d00;strokeWidth=1.2;align=left;verticalAlign=top;spacing=12;fontFamily=Inter;dashed=1;" vertex="1" parent="1"><mxGeometry x="40" y="1870" width="420" height="129" as="geometry" /></mxCell>
        <mxCell id="p1_gaps" value="&lt;div style=&quot;font-size:13px;&quot;&gt;&lt;b&gt;Known gaps&lt;/b&gt;&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#fdecea;strokeColor=#c0392b;fontColor=#6e1a12;strokeWidth=1.2;align=left;verticalAlign=top;spacing=12;fontFamily=Inter;dashed=1;" vertex="1" parent="1"><mxGeometry x="480" y="1870" width="640" height="42" as="geometry" /></mxCell>
