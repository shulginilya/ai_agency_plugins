        <mxCell id="p1_pair-programmer_c0" value="&lt;div style=&quot;font-size:11.5px;&quot;&gt;&lt;b&gt;&lt;font face=&quot;JetBrains Mono&quot;&gt;/pair-programmer:handoff&lt;/font&gt;&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:10.5px;color:#1b3a78;&quot;&gt;&lt;b&gt;Sonnet (alias: latest) · default effort&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:9.5px;color:#444444;&quot;&gt;Write the pairing handoff — goal, next step, decisions and their reasons, what was rejected, what is still…&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#e8f0fe;strokeColor=#3c6fd1;fontColor=#1b3a78;strokeWidth=1.2;align=left;verticalAlign=top;spacing=7;fontFamily=Inter;" vertex="1" parent="1"><mxGeometry x="60" y="3306" width="290" height="82" as="geometry" /></mxCell>
        <mxCell id="p1_pair-programmer_c1" value="&lt;div style=&quot;font-size:11.5px;&quot;&gt;&lt;b&gt;&lt;font face=&quot;JetBrains Mono&quot;&gt;/pair-programmer:navigate&lt;/font&gt;&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:10.5px;color:#1b3a78;&quot;&gt;&lt;b&gt;Sonnet (alias: latest) · default effort&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:9.5px;color:#444444;&quot;&gt;Take a navigator pass over the work in progress — goal, drift, silent decisions, unchecked assumptions.&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#e8f0fe;strokeColor=#3c6fd1;fontColor=#1b3a78;strokeWidth=1.2;align=left;verticalAlign=top;spacing=7;fontFamily=Inter;" vertex="1" parent="1"><mxGeometry x="60" y="3399" width="290" height="82" as="geometry" /></mxCell>
        <mxCell id="p1_pair-programmer_c2" value="&lt;div style=&quot;font-size:11.5px;&quot;&gt;&lt;b&gt;&lt;font face=&quot;JetBrains Mono&quot;&gt;/pair-programmer:pair&lt;/font&gt;&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:10.5px;color:#1b3a78;&quot;&gt;&lt;b&gt;Sonnet (alias: latest) · default effort&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:9.5px;color:#444444;&quot;&gt;Start or resume a pairing session — set the goal, the scope and the test command, and agree who is driving.&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#e8f0fe;strokeColor=#3c6fd1;fontColor=#1b3a78;strokeWidth=1.2;align=left;verticalAlign=top;spacing=7;fontFamily=Inter;" vertex="1" parent="1"><mxGeometry x="60" y="3491" width="290" height="82" as="geometry" /></mxCell>
