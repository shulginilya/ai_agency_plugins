        <mxCell id="p1_skill-trainer_e_skill-trainer_c1_skill-trainer_s1" value="" style="edgeStyle=none;html=1;endArrow=block;endFill=1;strokeColor=#b07a00;strokeWidth=1.4;fontSize=10;fontColor=#333333;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="350" y="4408" as="sourcePoint" /><mxPoint x="420" y="4380" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="p1_skill-trainer_e_skill-trainer_c2_skill-trainer_s1" value="" style="edgeStyle=none;html=1;endArrow=block;endFill=1;strokeColor=#b07a00;strokeWidth=1.4;fontSize=10;fontColor=#333333;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="350" y="4494" as="sourcePoint" /><mxPoint x="420" y="4390" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="p1_skill-trainer_e_skill-trainer_c3_skill-trainer_s1" value="" style="edgeStyle=none;html=1;endArrow=block;endFill=1;strokeColor=#b07a00;strokeWidth=1.4;fontSize=10;fontColor=#333333;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="350" y="4586" as="sourcePoint" /><mxPoint x="420" y="4399" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="p1_skill-trainer_e_skill-trainer_c4_skill-trainer_s1" value="" style="edgeStyle=none;html=1;endArrow=block;endFill=1;strokeColor=#b07a00;strokeWidth=1.4;fontSize=10;fontColor=#333333;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="350" y="4672" as="sourcePoint" /><mxPoint x="420" y="4409" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="p1_skill-trainer_e_skill-trainer_c5_skill-trainer_s0" value="" style="edgeStyle=none;html=1;endArrow=block;endFill=1;strokeColor=#b07a00;strokeWidth=1.4;fontSize=10;fontColor=#333333;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="350" y="4740" as="sourcePoint" /><mxPoint x="420" y="4327" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="p1_skill-trainer_e_skill-trainer_c5_skill-trainer_s1" value="" style="edgeStyle=none;html=1;endArrow=block;endFill=1;strokeColor=#b07a00;strokeWidth=1.4;fontSize=10;fontColor=#333333;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="350" y="4763" as="sourcePoint" /><mxPoint x="420" y="4419" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="p1__shared_frame" value="" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d08a00;fontColor=#333333;strokeWidth=1.4;align=left;verticalAlign=top;spacing=10;fontFamily=Inter;" vertex="1" parent="1"><mxGeometry x="1140" y="4214" width="1060" height="685" as="geometry" /></mxCell>
        <mxCell id="p1__shared_head" value="&lt;div style=&quot;font-size:16px;&quot;&gt;&lt;b&gt;Shared skills&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:10.5px;color:#555555;&quot;&gt;Shared skills · bundled into the plugins that list them in shared_skills&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontColor=#333333;strokeWidth=1.2;align=left;verticalAlign=top;spacing=6;fontFamily=Inter;" vertex="1" parent="1"><mxGeometry x="1152" y="4224" width="1036" height="48" as="geometry" /></mxCell>
        <mxCell id="p1__shared_s0" value="&lt;div style=&quot;font-size:12px;&quot;&gt;&lt;b&gt;board-setup&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:9.5px;color:#444444;&quot;&gt;Creates a GitHub Projects board for a repository, with the team&amp;#x27;s Status columns (In Definition, Backlog, Ready, In progress, In review, In…&lt;/div&gt;&lt;div style=&quot;font-size:9.5px;&quot;&gt;&lt;b&gt;bundled into: crew&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:9.5px;color:#333333;&quot;&gt;loaded by: /crew:create-board&lt;/div&gt;&lt;div style=&quot;font-size:9.5px;color:#5c3d00;&quot;&gt;&lt;i&gt;hands off to / uses: ticket-management, backlog-refinement (scrum-master)&lt;/i&gt;&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#fff8e6;strokeColor=#d08a00;fontColor=#5c3d00;strokeWidth=1.4;align=left;verticalAlign=top;spacing=7;fontFamily=Inter;" vertex="1" parent="1"><mxGeometry x="1520" y="4281" width="360" height="120" as="geometry" /></mxCell>
        <mxCell id="p1__shared_s1" value="&lt;div style=&quot;font-size:12px;&quot;&gt;&lt;b&gt;crew-workflow&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:9.5px;color:#444444;&quot;&gt;Runs ticket work through the crew in a repository whose GitHub Projects board has the crew columns (In approval, QA).&lt;/div&gt;&lt;div style=&quot;font-size:9.5px;&quot;&gt;&lt;b&gt;bundled into: crew&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:9.5px;color:#777777;&quot;&gt;&lt;i&gt;no command loads it: the model loads it from its description&lt;/i&gt;&lt;/div&gt;&lt;div style=&quot;font-size:9.5px;color:#5c3d00;&quot;&gt;&lt;i&gt;hands off to / uses: preview-link, test-driven-development, ticket-management, feature-implementation (developer)&lt;/i&gt;&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#fff8e6;strokeColor=#d08a00;fontColor=#5c3d00;strokeWidth=1.4;align=left;verticalAlign=top;spacing=7;fontFamily=Inter;" vertex="1" parent="1"><mxGeometry x="1520" y="4411" width="360" height="107" as="geometry" /></mxCell>
        <mxCell id="p1__shared_s2" value="&lt;div style=&quot;font-size:12px;&quot;&gt;&lt;b&gt;preview-link&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:9.5px;color:#444444;&quot;&gt;Finds the review link of a pull request — the URL of its preview deployment, read back from GitHub&amp;#x27;s Deployments API — and says whether it was…&lt;/div&gt;&lt;div style=&quot;font-size:9.5px;&quot;&gt;&lt;b&gt;bundled into: devops, qa&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:9.5px;color:#333333;&quot;&gt;loaded by: /devops:preview, /qa:verify&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#fff8e6;strokeColor=#d08a00;fontColor=#5c3d00;strokeWidth=1.4;align=left;verticalAlign=top;spacing=7;fontFamily=Inter;" vertex="1" parent="1"><mxGeometry x="1520" y="4529" width="360" height="94" as="geometry" /></mxCell>
        <mxCell id="p1__shared_s3" value="&lt;div style=&quot;font-size:12px;&quot;&gt;&lt;b&gt;test-driven-development&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:9.5px;color:#444444;&quot;&gt;Builds a feature or fix test-first in red-green-refactor cycles — a test list from the acceptance criteria, then one failing test per behaviour,…&lt;/div&gt;&lt;div style=&quot;font-size:9.5px;&quot;&gt;&lt;b&gt;bundled into: developer&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:9.5px;color:#333333;&quot;&gt;loaded by: /developer:fix, /developer:implement, /developer:tdd&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#fff8e6;strokeColor=#d08a00;fontColor=#5c3d00;strokeWidth=1.4;align=left;verticalAlign=top;spacing=7;fontFamily=Inter;" vertex="1" parent="1"><mxGeometry x="1520" y="4633" width="360" height="94" as="geometry" /></mxCell>
        <mxCell id="p1__shared_s4" value="&lt;div style=&quot;font-size:12px;&quot;&gt;&lt;b&gt;ticket-management&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:9.5px;color:#444444;&quot;&gt;Creates, edits, closes and deletes GitHub issues, creates a whole backlog from a plan in one rerunnable batch with epics linked to their slices, and…&lt;/div&gt;&lt;div style=&quot;font-size:9.5px;&quot;&gt;&lt;b&gt;bundled into: code-reviewer, crew, developer, notes, qa, scrum-master&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:9.5px;color:#333333;&quot;&gt;loaded by: /code-reviewer:review, /crew:create-board, /developer:ship, /notes:to-tickets, /qa:bug, /qa:plan, /qa:verify&lt;/div&gt;&lt;div style=&quot;font-size:9.5px;color:#5c3d00;&quot;&gt;&lt;i&gt;hands off to / uses: backlog-refinement (scrum-master)&lt;/i&gt;&lt;/div&gt;&lt;div style=&quot;font-size:9.5px;color:#5c3d00;&quot;&gt;&lt;i&gt;subagent from another plugin: story-splitter (scrum-master)&lt;/i&gt;&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#fff8e6;strokeColor=#d08a00;fontColor=#5c3d00;strokeWidth=1.4;align=left;verticalAlign=top;spacing=7;fontFamily=Inter;" vertex="1" parent="1"><mxGeometry x="1520" y="4737" width="360" height="146" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="page2" name="Models and effort">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1420" pageHeight="1087" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="p2_m_title" value="&lt;div style=&quot;font-size:22px;&quot;&gt;&lt;b&gt;Models and effort — what runs each command and subagent&lt;/b&gt;&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontColor=#1a1a1a;strokeWidth=1.2;align=left;verticalAlign=top;spacing=0;fontFamily=Inter;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1400" height="34" as="geometry" /></mxCell>
        <mxCell id="p2_m_sub" value="&lt;div style=&quot;font-size:11px;color:#666666;&quot;&gt;Pins from each command&amp;#x27;s and subagent&amp;#x27;s frontmatter. A skill runs on the pin of the command that loads it; a skill loaded by the session itself runs on the session&amp;#x27;s model.&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontColor=#666666;strokeWidth=1.2;align=left;verticalAlign=top;spacing=0;fontFamily=Inter;" vertex="1" parent="1"><mxGeometry x="40" y="56" width="1600" height="24" as="geometry" /></mxCell>
        <mxCell id="p2_h_0" value="&lt;div style=&quot;font-size:13px;&quot;&gt;&lt;b&gt;high&lt;/b&gt;&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#fafafa;strokeColor=#c8c8c8;fontColor=#333333;strokeWidth=1.2;align=center;verticalAlign=middle;spacing=4;fontFamily=Inter;" vertex="1" parent="1"><mxGeometry x="240" y="110" width="380" height="30" as="geometry" /></mxCell>
        <mxCell id="p2_h_1" value="&lt;div style=&quot;font-size:13px;&quot;&gt;&lt;b&gt;medium&lt;/b&gt;&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#fafafa;strokeColor=#c8c8c8;fontColor=#333333;strokeWidth=1.2;align=center;verticalAlign=middle;spacing=4;fontFamily=Inter;" vertex="1" parent="1"><mxGeometry x="620" y="110" width="380" height="30" as="geometry" /></mxCell>
        <mxCell id="p2_h_2" value="&lt;div style=&quot;font-size:13px;&quot;&gt;&lt;b&gt;default effort&lt;/b&gt;&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#fafafa;strokeColor=#c8c8c8;fontColor=#333333;strokeWidth=1.2;align=center;verticalAlign=middle;spacing=4;fontFamily=Inter;" vertex="1" parent="1"><mxGeometry x="1000" y="110" width="380" height="30" as="geometry" /></mxCell>
        <mxCell id="p2_r_0" value="&lt;div style=&quot;font-size:13px;&quot;&gt;&lt;b&gt;Opus 5.5&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:9.5px;color:#555555;&quot;&gt;&lt;font face=&quot;JetBrains Mono&quot;&gt;claude-opus-5-5&lt;/font&gt;&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f3e8fd;strokeColor=#8e44ad;fontColor=#4a1f63;strokeWidth=1.2;align=left;verticalAlign=top;spacing=8;fontFamily=Inter;" vertex="1" parent="1"><mxGeometry x="40" y="140" width="200" height="170" as="geometry" /></mxCell>
        <mxCell id="p2_cell_0_0" value="&lt;div style=&quot;font-size:9.5px;&quot;&gt;&lt;font face=&quot;JetBrains Mono&quot;&gt;/developer:bisect  → regression-triage, root-cause-analysis&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;font-size:9.5px;&quot;&gt;&lt;font face=&quot;JetBrains Mono&quot;&gt;/developer:diagnose  → root-cause-analysis&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;font-size:9.5px;&quot;&gt;&lt;font face=&quot;JetBrains Mono&quot;&gt;/developer:fix  → test-driven-development, root-cause-analysis&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;font-size:9.5px;&quot;&gt;&lt;font face=&quot;JetBrains Mono&quot;&gt;/developer:implement  → test-driven-development, feature-implementation&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;font-size:9.5px;&quot;&gt;&lt;font face=&quot;JetBrains Mono&quot;&gt;/developer:refactor  → safe-refactoring&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;font-size:9.5px;&quot;&gt;&lt;font face=&quot;JetBrains Mono&quot;&gt;/developer:tdd  → test-driven-development&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;font-size:9.5px;&quot;&gt;&lt;font face=&quot;JetBrains Mono&quot;&gt;subagent developer:investigator&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;font-size:9.5px;&quot;&gt;&lt;font face=&quot;JetBrains Mono&quot;&gt;/devops:preview  → preview-link, ci-setup, preview-environments&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;font-size:9.5px;&quot;&gt;&lt;font face=&quot;JetBrains Mono&quot;&gt;/code-reviewer:review  → ticket-management, pr-review&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;font-size:9.5px;&quot;&gt;&lt;font face=&quot;JetBrains Mono&quot;&gt;/skill-trainer:plan  → training-plan&lt;/font&gt;&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f3e8fd;strokeColor=#8e44ad;fontColor=#4a1f63;strokeWidth=1.2;align=left;verticalAlign=top;spacing=8;fontFamily=Inter;" vertex="1" parent="1"><mxGeometry x="240" y="140" width="380" height="170" as="geometry" /></mxCell>
        <mxCell id="p2_cell_0_1" value="&lt;div style=&quot;font-size:9.5px;&quot;&gt;&lt;font face=&quot;JetBrains Mono&quot;&gt;/developer:resolve-conflicts  → merge-conflict-resolution&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;font-size:9.5px;&quot;&gt;&lt;font face=&quot;JetBrains Mono&quot;&gt;/developer:ship  → ticket-management, ship-change&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;font-size:9.5px;&quot;&gt;&lt;font face=&quot;JetBrains Mono&quot;&gt;/developer:verify  → feature-implementation&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;font-size:9.5px;&quot;&gt;&lt;font face=&quot;JetBrains Mono&quot;&gt;subagent developer:implementer&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;font-size:9.5px;&quot;&gt;&lt;font face=&quot;JetBrains Mono&quot;&gt;/designer:spec  → design-spec, ux-review&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;font-size:9.5px;&quot;&gt;&lt;font face=&quot;JetBrains Mono&quot;&gt;/devops:ci  → ci-setup, pipeline-triage&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;font-size:9.5px;&quot;&gt;&lt;font face=&quot;JetBrains Mono&quot;&gt;subagent code-reviewer:reviewer&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;font-size:9.5px;&quot;&gt;&lt;font face=&quot;JetBrains Mono&quot;&gt;/notes:organize  → note-keeping&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;font-size:9.5px;&quot;&gt;&lt;font face=&quot;JetBrains Mono&quot;&gt;/notes:to-tickets  → ticket-management, note-keeping, notes-to-tickets&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;font-size:9.5px;&quot;&gt;&lt;font face=&quot;JetBrains Mono&quot;&gt;subagent plugin-developer:plugin-developer&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;font-size:9.5px;&quot;&gt;&lt;font face=&quot;JetBrains Mono&quot;&gt;subagent plugin-developer:requirements-auditor&lt;/font&gt;&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f3e8fd;strokeColor=#8e44ad;fontColor=#4a1f63;strokeWidth=1.2;align=left;verticalAlign=top;spacing=8;fontFamily=Inter;" vertex="1" parent="1"><mxGeometry x="620" y="140" width="380" height="170" as="geometry" /></mxCell>
        <mxCell id="p2_cell_0_2" value="&lt;div style=&quot;font-size:9.5px;&quot;&gt;&lt;font face=&quot;JetBrains Mono&quot;&gt;/skill-trainer:interview  → interview-track, training-plan&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;font-size:9.5px;&quot;&gt;&lt;font face=&quot;JetBrains Mono&quot;&gt;/skill-trainer:today  → interview-track, training-plan&lt;/font&gt;&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f3e8fd;strokeColor=#8e44ad;fontColor=#4a1f63;strokeWidth=1.2;align=left;verticalAlign=top;spacing=8;fontFamily=Inter;" vertex="1" parent="1"><mxGeometry x="1000" y="140" width="380" height="170" as="geometry" /></mxCell>
