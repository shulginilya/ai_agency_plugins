        <mxCell id="p1_skill-trainer_c5" value="&lt;div style=&quot;font-size:11.5px;&quot;&gt;&lt;b&gt;&lt;font face=&quot;JetBrains Mono&quot;&gt;/skill-trainer:today&lt;/font&gt;&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:10.5px;color:#4a1f63;&quot;&gt;&lt;b&gt;Opus 5.5 · default effort&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:9.5px;color:#444444;&quot;&gt;Run today&amp;#x27;s training session — reviews that are due first, then the next topic — and grade and log it.&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f3e8fd;strokeColor=#8e44ad;fontColor=#4a1f63;strokeWidth=1.2;align=left;verticalAlign=top;spacing=7;fontFamily=Inter;" vertex="1" parent="1"><mxGeometry x="60" y="4717" width="290" height="69" as="geometry" /></mxCell>
        <mxCell id="p1_skill-trainer_s0" value="&lt;div style=&quot;font-size:12px;&quot;&gt;&lt;b&gt;interview-track&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:9.5px;color:#444444;&quot;&gt;Trains for the technical phases of senior engineering interviews, coding and system design, with the screening round skipped.&lt;/div&gt;&lt;div style=&quot;font-size:9.5px;color:#5c3d00;&quot;&gt;&lt;i&gt;hands off to / uses: training-plan&lt;/i&gt;&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#fff8e6;strokeColor=#d08a00;fontColor=#5c3d00;strokeWidth=1.4;align=left;verticalAlign=top;spacing=7;fontFamily=Inter;" vertex="1" parent="1"><mxGeometry x="420" y="4281" width="360" height="69" as="geometry" /></mxCell>
        <mxCell id="p1_skill-trainer_s1" value="&lt;div style=&quot;font-size:12px;&quot;&gt;&lt;b&gt;training-plan&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:9.5px;color:#444444;&quot;&gt;Keeps a working engineer&amp;#x27;s skills sharp next to a full-time job with a daily plan (about 40 minutes) and a weekly plan (two to four longer sessions)…&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#fff8e6;strokeColor=#d08a00;fontColor=#5c3d00;strokeWidth=1.4;align=left;verticalAlign=top;spacing=7;fontFamily=Inter;" vertex="1" parent="1"><mxGeometry x="420" y="4360" width="360" height="69" as="geometry" /></mxCell>
        <mxCell id="p1_skill-trainer_e_skill-trainer_c0_skill-trainer_s0" value="" style="edgeStyle=none;html=1;endArrow=block;endFill=1;strokeColor=#b07a00;strokeWidth=1.4;fontSize=10;fontColor=#333333;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="350" y="4309" as="sourcePoint" /><mxPoint x="420" y="4304" as="targetPoint" /></mxGeometry></mxCell>
