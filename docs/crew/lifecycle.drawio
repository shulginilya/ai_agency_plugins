        <mxCell id="p1_l_title" value="&lt;div style=&quot;font-size:22px;&quot;&gt;&lt;b&gt;Ticket lifecycle — from idea to Done&lt;/b&gt;&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontColor=#1a1a1a;strokeWidth=1.2;align=left;verticalAlign=top;spacing=0;fontFamily=Inter;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1400" height="34" as="geometry" /></mxCell>
        <mxCell id="p1_l_sub" value="&lt;div style=&quot;font-size:11px;color:#666666;&quot;&gt;Generated by integrations/crew/lifecycle_diagram.py from create_board.py, the plugins&amp;#x27; commands, team.json and lifecycle.json — edit those, not this file.&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontColor=#666666;strokeWidth=1.2;align=left;verticalAlign=top;spacing=0;fontFamily=Inter;" vertex="1" parent="1"><mxGeometry x="40" y="56" width="1500" height="24" as="geometry" /></mxCell>
        <mxCell id="p1_entry_0_0" value="&lt;div style=&quot;font-size:9px;color:#777777;&quot;&gt;&lt;b&gt;New ticket&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:11px;&quot;&gt;&lt;b&gt;Captain · Notes&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:10px;&quot;&gt;A raw idea; notes:to-tickets files (optional) items here&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f4f4f4;strokeColor=#8a8a8a;fontColor=#333333;strokeWidth=1.2;align=left;verticalAlign=top;spacing=10;fontFamily=Inter;dashed=1;" vertex="1" parent="1"><mxGeometry x="40" y="110" width="250" height="74" as="geometry" /></mxCell>
        <mxCell id="p1_col_0" value="&lt;div style=&quot;font-size:16px;&quot;&gt;&lt;b&gt;In Definition&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:11px;color:#444444;&quot;&gt;&lt;i&gt;An idea not yet understood well enough to refine.&lt;/i&gt;&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#e8f0fe;strokeColor=#3c6fd1;fontColor=#1b3a78;strokeWidth=1.6;align=left;verticalAlign=top;spacing=12;fontFamily=Inter;" vertex="1" parent="1"><mxGeometry x="360" y="110" width="470" height="74" as="geometry" /></mxCell>
        <mxCell id="p1_entry_e_0_0" value="" style="edgeStyle=none;html=1;endArrow=block;endFill=1;strokeColor=#8a8a8a;strokeWidth=1.4;fontSize=10;fontColor=#333333;labelBackgroundColor=#ffffff;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="290" y="147" as="sourcePoint" /><mxPoint x="360" y="147" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="p1_fwd_l_0" value="&lt;div style=&quot;font-size:11px;&quot;&gt;&lt;b&gt;Scrum Master&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:10px;&quot;&gt;/scrum-master:refine turns the idea into a story&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontColor=#333333;strokeWidth=1.2;align=left;verticalAlign=top;spacing=6;fontFamily=Inter;" vertex="1" parent="1"><mxGeometry x="430" y="192" width="400" height="40" as="geometry" /></mxCell>
        <mxCell id="p1_fwd_0" value="" style="edgeStyle=none;html=1;endArrow=block;endFill=1;strokeColor=#3c6fd1;strokeWidth=1.4;fontSize=10;fontColor=#333333;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="410" y="184" as="sourcePoint" /><mxPoint x="410" y="240" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="p1_entry_1_0" value="&lt;div style=&quot;font-size:9px;color:#777777;&quot;&gt;&lt;b&gt;New ticket&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:11px;&quot;&gt;&lt;b&gt;Scrum Master · QA Engineer · Notes&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:10px;&quot;&gt;Refined stories filed with tickets.py batch; /qa:bug files each bug labelled QA testing; notes files TODO items&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f4f4f4;strokeColor=#8a8a8a;fontColor=#333333;strokeWidth=1.2;align=left;verticalAlign=top;spacing=10;fontFamily=Inter;dashed=1;" vertex="1" parent="1"><mxGeometry x="40" y="240" width="250" height="88" as="geometry" /></mxCell>
        <mxCell id="p1_col_1" value="&lt;div style=&quot;font-size:16px;&quot;&gt;&lt;b&gt;Backlog&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:11px;color:#444444;&quot;&gt;&lt;i&gt;Refined into a story with user value and testable acceptance criteria, or waiting to be.&lt;/i&gt;&lt;/div&gt;&lt;div style=&quot;font-size:9px;color:#777777;margin-top:6px;&quot;&gt;&lt;b&gt;WHILE HERE&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:10.5px;&quot;&gt;• Scrum Master: /scrum-master:refine: value, criteria, size; items sized 13+ split by the story-splitter&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#e8f0fe;strokeColor=#3c6fd1;fontColor=#1b3a78;strokeWidth=1.6;align=left;verticalAlign=top;spacing=12;fontFamily=Inter;" vertex="1" parent="1"><mxGeometry x="360" y="240" width="470" height="122" as="geometry" /></mxCell>
        <mxCell id="p1_entry_e_1_0" value="" style="edgeStyle=none;html=1;endArrow=block;endFill=1;strokeColor=#8a8a8a;strokeWidth=1.4;fontSize=10;fontColor=#333333;labelBackgroundColor=#ffffff;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="290" y="284" as="sourcePoint" /><mxPoint x="360" y="284" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="p1_fwd_l_1" value="&lt;div style=&quot;font-size:11px;&quot;&gt;&lt;b&gt;Scrum Master&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:10px;&quot;&gt;Meets the Definition of Ready&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontColor=#333333;strokeWidth=1.2;align=left;verticalAlign=top;spacing=6;fontFamily=Inter;" vertex="1" parent="1"><mxGeometry x="430" y="370" width="400" height="40" as="geometry" /></mxCell>
        <mxCell id="p1_fwd_1" value="" style="edgeStyle=none;html=1;endArrow=block;endFill=1;strokeColor=#3c6fd1;strokeWidth=1.4;fontSize=10;fontColor=#333333;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="410" y="362" as="sourcePoint" /><mxPoint x="410" y="418" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="p1_col_2" value="&lt;div style=&quot;font-size:16px;&quot;&gt;&lt;b&gt;Ready&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:11px;color:#444444;&quot;&gt;&lt;i&gt;Meets the Definition of Ready: testable criteria, a size, and small enough to finish inside one sprint.&lt;/i&gt;&lt;/div&gt;&lt;div style=&quot;font-size:9px;color:#777777;margin-top:6px;&quot;&gt;&lt;b&gt;WHILE HERE&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:10.5px;&quot;&gt;• Scrum Master: /scrum-master:plan-sprint picks the tickets that fit the sprint goal and capacity&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#e8f0fe;strokeColor=#3c6fd1;fontColor=#1b3a78;strokeWidth=1.6;align=left;verticalAlign=top;spacing=12;fontFamily=Inter;" vertex="1" parent="1"><mxGeometry x="360" y="418" width="470" height="122" as="geometry" /></mxCell>
        <mxCell id="p1_fwd_l_2" value="&lt;div style=&quot;font-size:11px;&quot;&gt;&lt;b&gt;Developer&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:10px;&quot;&gt;The developer starts the ticket (crew-workflow: one column at a time, without asking)&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontColor=#333333;strokeWidth=1.2;align=left;verticalAlign=top;spacing=6;fontFamily=Inter;" vertex="1" parent="1"><mxGeometry x="430" y="548" width="400" height="54" as="geometry" /></mxCell>
        <mxCell id="p1_fwd_2" value="" style="edgeStyle=none;html=1;endArrow=block;endFill=1;strokeColor=#3c6fd1;strokeWidth=1.4;fontSize=10;fontColor=#333333;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="410" y="540" as="sourcePoint" /><mxPoint x="410" y="610" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="p1_col_3" value="&lt;div style=&quot;font-size:16px;&quot;&gt;&lt;b&gt;In progress&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:11px;color:#444444;&quot;&gt;&lt;i&gt;Being built, or sent back by code review or QA to be fixed.&lt;/i&gt;&lt;/div&gt;&lt;div style=&quot;font-size:9px;color:#777777;margin-top:6px;&quot;&gt;&lt;b&gt;WHILE HERE&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:10.5px;&quot;&gt;• QA Engineer: /qa:plan: test cases for every acceptance criterion, before it is built&lt;/div&gt;&lt;div style=&quot;font-size:10.5px;&quot;&gt;• UI/UX Designer: UI ticket: /designer:spec before building, /designer:review before pushing&lt;/div&gt;&lt;div style=&quot;font-size:10.5px;&quot;&gt;• Developer: /developer:implement test-first; self-review the diff; /developer:verify passes&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#e8f0fe;strokeColor=#3c6fd1;fontColor=#1b3a78;strokeWidth=1.6;align=left;verticalAlign=top;spacing=12;fontFamily=Inter;" vertex="1" parent="1"><mxGeometry x="360" y="610" width="470" height="164" as="geometry" /></mxCell>
        <mxCell id="p1_fwd_l_3" value="&lt;div style=&quot;font-size:11px;&quot;&gt;&lt;b&gt;Developer&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:10px;&quot;&gt;/developer:ship: branch, PR that closes the ticket, card moved after the PR exists&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontColor=#333333;strokeWidth=1.2;align=left;verticalAlign=top;spacing=6;fontFamily=Inter;" vertex="1" parent="1"><mxGeometry x="430" y="782" width="400" height="54" as="geometry" /></mxCell>
        <mxCell id="p1_fwd_3" value="" style="edgeStyle=none;html=1;endArrow=block;endFill=1;strokeColor=#3c6fd1;strokeWidth=1.4;fontSize=10;fontColor=#333333;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="410" y="774" as="sourcePoint" /><mxPoint x="410" y="844" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="p1_col_4" value="&lt;div style=&quot;font-size:16px;&quot;&gt;&lt;b&gt;In review&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:11px;color:#444444;&quot;&gt;&lt;i&gt;A PR that closes the ticket is open, waiting for code review.&lt;/i&gt;&lt;/div&gt;&lt;div style=&quot;font-size:9px;color:#777777;margin-top:6px;&quot;&gt;&lt;b&gt;WHILE HERE&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:10.5px;&quot;&gt;• Code Reviewer: /code-reviewer:review: approve moves it on; request changes sends it back&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#e8f0fe;strokeColor=#3c6fd1;fontColor=#1b3a78;strokeWidth=1.6;align=left;verticalAlign=top;spacing=12;fontFamily=Inter;" vertex="1" parent="1"><mxGeometry x="360" y="844" width="470" height="107" as="geometry" /></mxCell>
        <mxCell id="p1_fwd_l_4" value="&lt;div style=&quot;font-size:11px;&quot;&gt;&lt;b&gt;Code Reviewer&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:10px;&quot;&gt;/code-reviewer:review approve: no blocker or major finding&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontColor=#333333;strokeWidth=1.2;align=left;verticalAlign=top;spacing=6;fontFamily=Inter;" vertex="1" parent="1"><mxGeometry x="430" y="959" width="400" height="40" as="geometry" /></mxCell>
        <mxCell id="p1_fwd_4" value="" style="edgeStyle=none;html=1;endArrow=block;endFill=1;strokeColor=#3c6fd1;strokeWidth=1.4;fontSize=10;fontColor=#333333;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="410" y="951" as="sourcePoint" /><mxPoint x="410" y="1007" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="p1_col_5" value="&lt;div style=&quot;font-size:16px;&quot;&gt;&lt;b&gt;In approval&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:11px;color:#444444;&quot;&gt;&lt;i&gt;Code review approved. The Captain reviews the code personally before QA sees it.&lt;/i&gt;&lt;/div&gt;&lt;div style=&quot;font-size:9px;color:#777777;margin-top:6px;&quot;&gt;&lt;b&gt;WHILE HERE&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:10.5px;&quot;&gt;• Captain: Reviews the PR&amp;#x27;s code; on approval moves the card to QA&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#e8f0fe;strokeColor=#3c6fd1;fontColor=#1b3a78;strokeWidth=1.6;align=left;verticalAlign=top;spacing=12;fontFamily=Inter;" vertex="1" parent="1"><mxGeometry x="360" y="1007" width="470" height="108" as="geometry" /></mxCell>
        <mxCell id="p1_fwd_l_5" value="&lt;div style=&quot;font-size:11px;&quot;&gt;&lt;b&gt;Captain&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:10px;&quot;&gt;The Captain approves the code; the move starts /qa:verify&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontColor=#333333;strokeWidth=1.2;align=left;verticalAlign=top;spacing=6;fontFamily=Inter;" vertex="1" parent="1"><mxGeometry x="430" y="1123" width="400" height="40" as="geometry" /></mxCell>
        <mxCell id="p1_fwd_5" value="" style="edgeStyle=none;html=1;endArrow=block;endFill=1;strokeColor=#3c6fd1;strokeWidth=1.4;fontSize=10;fontColor=#333333;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="410" y="1115" as="sourcePoint" /><mxPoint x="410" y="1171" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="p1_col_6" value="&lt;div style=&quot;font-size:16px;&quot;&gt;&lt;b&gt;QA&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:11px;color:#444444;&quot;&gt;&lt;i&gt;Approved for testing. QA picks up tickets only from this column.&lt;/i&gt;&lt;/div&gt;&lt;div style=&quot;font-size:9px;color:#777777;margin-top:6px;&quot;&gt;&lt;b&gt;WHILE HERE&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:10.5px;&quot;&gt;• QA Engineer: /qa:verify on the PR&amp;#x27;s head commit, run locally (review links paused)&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#e8f0fe;strokeColor=#3c6fd1;fontColor=#1b3a78;strokeWidth=1.6;align=left;verticalAlign=top;spacing=12;fontFamily=Inter;" vertex="1" parent="1"><mxGeometry x="360" y="1171" width="470" height="107" as="geometry" /></mxCell>
        <mxCell id="p1_fwd_l_6" value="&lt;div style=&quot;font-size:11px;&quot;&gt;&lt;b&gt;QA Engineer&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:10px;&quot;&gt;/qa:verify accept: every criterion passed with evidence (adds the column if the board lacks it)&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontColor=#333333;strokeWidth=1.2;align=left;verticalAlign=top;spacing=6;fontFamily=Inter;" vertex="1" parent="1"><mxGeometry x="430" y="1286" width="400" height="54" as="geometry" /></mxCell>
        <mxCell id="p1_fwd_6" value="" style="edgeStyle=none;html=1;endArrow=block;endFill=1;strokeColor=#3c6fd1;strokeWidth=1.4;fontSize=10;fontColor=#333333;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="410" y="1278" as="sourcePoint" /><mxPoint x="410" y="1348" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="p1_col_7" value="&lt;div style=&quot;font-size:16px;&quot;&gt;&lt;b&gt;Ready for Merge&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:11px;color:#444444;&quot;&gt;&lt;i&gt;Passed QA with evidence for every criterion. Waiting for the Captain&amp;#x27;s merge.&lt;/i&gt;&lt;/div&gt;&lt;div style=&quot;font-size:9px;color:#777777;margin-top:6px;&quot;&gt;&lt;b&gt;WHILE HERE&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:10.5px;&quot;&gt;• Captain: Reviews and merges the PR&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#e8f0fe;strokeColor=#3c6fd1;fontColor=#1b3a78;strokeWidth=1.6;align=left;verticalAlign=top;spacing=12;fontFamily=Inter;" vertex="1" parent="1"><mxGeometry x="360" y="1348" width="470" height="108" as="geometry" /></mxCell>
        <mxCell id="p1_fwd_l_7" value="&lt;div style=&quot;font-size:11px;&quot;&gt;&lt;b&gt;Captain · GitHub&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:10px;&quot;&gt;The Captain merges; GitHub closes the ticket and the board moves it&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontColor=#333333;strokeWidth=1.2;align=left;verticalAlign=top;spacing=6;fontFamily=Inter;" vertex="1" parent="1"><mxGeometry x="430" y="1463" width="400" height="40" as="geometry" /></mxCell>
        <mxCell id="p1_fwd_7" value="" style="edgeStyle=none;html=1;endArrow=block;endFill=1;strokeColor=#3c6fd1;strokeWidth=1.4;fontSize=10;fontColor=#333333;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="410" y="1455" as="sourcePoint" /><mxPoint x="410" y="1512" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="p1_col_8" value="&lt;div style=&quot;font-size:16px;&quot;&gt;&lt;b&gt;Done&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:11px;color:#444444;&quot;&gt;&lt;i&gt;Merged. GitHub closed the ticket through the PR&amp;#x27;s Closes #N.&lt;/i&gt;&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#e8f6ee;strokeColor=#2e8b57;fontColor=#174d30;strokeWidth=1.6;align=left;verticalAlign=top;spacing=12;fontFamily=Inter;" vertex="1" parent="1"><mxGeometry x="360" y="1512" width="470" height="60" as="geometry" /></mxCell>
        <mxCell id="p1_lane_0" value="" style="edgeStyle=none;html=1;endArrow=block;endFill=1;strokeColor=#c0392b;strokeWidth=1.4;fontSize=10;fontColor=#333333;labelBackgroundColor=#ffffff;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="830" y="886" as="sourcePoint" /><mxPoint x="830" y="708" as="targetPoint" /><Array as="points"><mxPoint x="870" y="886" /><mxPoint x="870" y="708" /></Array></mxGeometry></mxCell>
        <mxCell id="p1_lane_l_0" value="&lt;div style=&quot;font-size:11px;color:#c0392b;&quot;&gt;&lt;b&gt;Back: Code Reviewer&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:9.5px;color:#777777;&quot;&gt;In review → In progress&lt;/div&gt;&lt;div style=&quot;font-size:10px;&quot;&gt;Request changes: any blocker or major finding&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#fdecea;strokeColor=#c0392b;fontColor=#6e1a12;strokeWidth=1.2;align=left;verticalAlign=top;spacing=8;fontFamily=Inter;" vertex="1" parent="1"><mxGeometry x="1026" y="698" width="300" height="57" as="geometry" /></mxCell>
        <mxCell id="p1_lane_1" value="" style="edgeStyle=none;html=1;endArrow=block;endFill=1;strokeColor=#c0392b;strokeWidth=1.4;fontSize=10;fontColor=#333333;labelBackgroundColor=#ffffff;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="830" y="900" as="sourcePoint" /><mxPoint x="830" y="476" as="targetPoint" /><Array as="points"><mxPoint x="904" y="900" /><mxPoint x="904" y="476" /></Array></mxGeometry></mxCell>
        <mxCell id="p1_lane_l_1" value="&lt;div style=&quot;font-size:11px;color:#c0392b;&quot;&gt;&lt;b&gt;Back: Code Reviewer&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:9.5px;color:#777777;&quot;&gt;In review → Ready&lt;/div&gt;&lt;div style=&quot;font-size:10px;&quot;&gt;Stop: the third review round still finds a blocker, major or minor; @mentions and emails the Captain&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#fdecea;strokeColor=#c0392b;fontColor=#6e1a12;strokeWidth=1.2;align=left;verticalAlign=top;spacing=8;fontFamily=Inter;" vertex="1" parent="1"><mxGeometry x="1026" y="768" width="300" height="71" as="geometry" /></mxCell>
        <mxCell id="p1_lane_2" value="" style="edgeStyle=none;html=1;endArrow=block;endFill=1;strokeColor=#3c6fd1;strokeWidth=1.4;fontSize=10;fontColor=#333333;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="830" y="881" as="sourcePoint" /><mxPoint x="830" y="1240" as="targetPoint" /><Array as="points"><mxPoint x="938" y="881" /><mxPoint x="938" y="1240" /></Array></mxGeometry></mxCell>
        <mxCell id="p1_lane_l_2" value="&lt;div style=&quot;font-size:11px;color:#3c6fd1;&quot;&gt;&lt;b&gt;Code Reviewer&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:9.5px;color:#777777;&quot;&gt;In review → QA&lt;/div&gt;&lt;div style=&quot;font-size:10px;&quot;&gt;Approve on a ticket labelled skip_approval: skips the Captain&amp;#x27;s review&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#e8f0fe;strokeColor=#3c6fd1;fontColor=#1b3a78;strokeWidth=1.2;align=left;verticalAlign=top;spacing=8;fontFamily=Inter;" vertex="1" parent="1"><mxGeometry x="1026" y="871" width="300" height="71" as="geometry" /></mxCell>
        <mxCell id="p1_lane_3" value="" style="edgeStyle=none;html=1;endArrow=block;endFill=1;strokeColor=#c0392b;strokeWidth=1.4;fontSize=10;fontColor=#333333;labelBackgroundColor=#ffffff;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="830" y="1254" as="sourcePoint" /><mxPoint x="830" y="647" as="targetPoint" /><Array as="points"><mxPoint x="972" y="1254" /><mxPoint x="972" y="647" /></Array></mxGeometry></mxCell>
        <mxCell id="p1_lane_l_3" value="&lt;div style=&quot;font-size:11px;color:#c0392b;&quot;&gt;&lt;b&gt;Back: QA Engineer&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:9.5px;color:#777777;&quot;&gt;QA → In progress&lt;/div&gt;&lt;div style=&quot;font-size:10px;&quot;&gt;Reject: a comment on what fails, a bug ticket per failure&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#fdecea;strokeColor=#c0392b;fontColor=#6e1a12;strokeWidth=1.2;align=left;verticalAlign=top;spacing=8;fontFamily=Inter;" vertex="1" parent="1"><mxGeometry x="1026" y="954" width="300" height="71" as="geometry" /></mxCell>
        <mxCell id="p1_legend" value="&lt;div style=&quot;font-size:12px;&quot;&gt;&lt;b&gt;Legend&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:10px;&quot;&gt;Blue arrow: the card moves forward, made by the movers named beside it&lt;/div&gt;&lt;div style=&quot;font-size:10px;&quot;&gt;Red dashed arrow: the card goes back to be fixed&lt;/div&gt;&lt;div style=&quot;font-size:10px;&quot;&gt;Grey dashed box: how a new ticket enters the board&lt;/div&gt;&lt;div style=&quot;font-size:10px;&quot;&gt;While here: what happens to the card before it moves on&lt;/div&gt;&lt;div style=&quot;font-size:10px;&quot;&gt;Red box: drift between lifecycle.json and the repo&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#fafafa;strokeColor=#c8c8c8;fontColor=#333333;strokeWidth=1.2;align=left;verticalAlign=top;spacing=10;fontFamily=Inter;" vertex="1" parent="1"><mxGeometry x="1366" y="110" width="330" height="117" as="geometry" /></mxCell>
      </root>
