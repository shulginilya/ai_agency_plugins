        </mxCell>
        <mxCell id="kitnote" value="Python appears only where an output FORMAT differs:&lt;br&gt;Gemini TOML commands · OpenCode MCP shape · Codex config.toml snippet.&lt;br&gt;A new harness usually needs none of it — just a new JSON manifest." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;spacingLeft=10;spacingTop=4;verticalAlign=top;fontSize=11;fillColor=#f7f7f7;strokeColor=#b3b3b3;fontColor=#333333;" vertex="1" parent="1">
