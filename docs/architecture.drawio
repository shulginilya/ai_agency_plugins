          <mxGeometry x="12" y="88" width="276" height="34" as="geometry" />
        </mxCell>
        <mxCell id="src_r2" value="commands/&amp;lt;c&amp;gt;.md   {{ARGS}} {{ARG1}} {{ARG2}}" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;spacingLeft=8;fontSize=11;fillColor=#ffffff;strokeColor=#c2c2c2;verticalAlign=middle;" vertex="1" parent="src">
          <mxGeometry x="12" y="128" width="276" height="34" as="geometry" />
        </mxCell>
