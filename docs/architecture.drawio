        </mxCell>
        <mxCell id="c5_2" value="emulated&lt;br&gt;as skill" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=center;fontSize=11;fillColor=#fde9c9;strokeColor=#d79b00;fontColor=#7a4d00;" vertex="1" parent="1">
          <mxGeometry x="680" y="528" width="210" height="62" as="geometry" />
        </mxCell>
        <mxCell id="c5_3" value="—&lt;br&gt;—" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=center;fontSize=11;fillColor=#ededed;strokeColor=#999999;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="890" y="528" width="210" height="62" as="geometry" />
        </mxCell>
        <mxCell id="c5_4" value="manual&lt;br&gt;reference only" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=center;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#1f3864;" vertex="1" parent="1">
          <mxGeometry x="1100" y="528" width="210" height="62" as="geometry" />
        </mxCell>
        <mxCell id="leverage" value=".agents/skills is the leverage point&lt;br&gt;&lt;br&gt;Codex CLI, Cursor, Gemini CLI and OpenCode all read it.&lt;br&gt;apkit install &amp;lt;plugin&amp;gt; --target agents covers four harnesses in one step.&lt;br&gt;The per-harness targets exist for what .agents/skills does not carry:&lt;br&gt;commands, subagents, hooks, MCP config.&lt;br&gt;&lt;br&gt;Installing both the generic and a specific target puts the same skill in two&lt;br&gt;discovered locations — harnesses resolve that by precedence rather than erroring,&lt;br&gt;but you then have two copies to keep in step. Pick one." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;spacingLeft=10;spacingTop=4;verticalAlign=top;fontSize=11;fillColor=#f7f7f7;strokeColor=#b3b3b3;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="40" y="620" width="620" height="190" as="geometry" />
        </mxCell>
        <mxCell id="unverif" value="Still inferred, not verified against docs&lt;br&gt;&lt;br&gt;codex.commands · cursor.commands · opencode.commands · gemini-cli.commands&lt;br&gt;opencode.agents · opencode.mcp · gemini-cli.mcp&lt;br&gt;&lt;br&gt;Skill discovery paths are verified for all six targets.&lt;br&gt;Confirm one against a live harness → flip &quot;verified&quot;: true in the manifest&lt;br&gt;and update docs/harness-matrix.md. That flag is the repo&apos;s memory of&lt;br&gt;what has actually been checked." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;spacingLeft=10;spacingTop=4;verticalAlign=top;fontSize=11;fillColor=#f7f7f7;strokeColor=#b3b3b3;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="690" y="620" width="620" height="190" as="geometry" />
        </mxCell>
        <mxCell id="legend" value="legend" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;spacingLeft=10;spacingTop=4;verticalAlign=top;fontSize=11;fillColor=#f7f7f7;strokeColor=#b3b3b3;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="1340" y="620" width="250" height="190" as="geometry" />
        </mxCell>
        <mxCell id="lg0" value="native — harness&apos;s own concept" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=center;fontSize=11;fillColor=#d5efd9;strokeColor=#3f8f52;fontColor=#1d5228;align=left;spacingLeft=8;" vertex="1" parent="legend">
          <mxGeometry x="14" y="44" width="222" height="28" as="geometry" />
        </mxCell>
        <mxCell id="lg1" value="emulated — closest equivalent" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=center;fontSize=11;fillColor=#fde9c9;strokeColor=#d79b00;fontColor=#7a4d00;align=left;spacingLeft=8;" vertex="1" parent="legend">
          <mxGeometry x="14" y="78" width="222" height="28" as="geometry" />
        </mxCell>
        <mxCell id="lg2" value="manual — snippet to merge by hand" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=center;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#1f3864;align=left;spacingLeft=8;" vertex="1" parent="legend">
          <mxGeometry x="14" y="112" width="222" height="28" as="geometry" />
        </mxCell>
        <mxCell id="lg3" value="unsupported — dropped, reason reported" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=center;fontSize=11;fillColor=#ededed;strokeColor=#999999;fontColor=#666666;align=left;spacingLeft=8;" vertex="1" parent="legend">
          <mxGeometry x="14" y="146" width="222" height="28" as="geometry" />
        </mxCell>
      </root>
