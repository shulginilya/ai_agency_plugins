  </diagram>
  <diagram name="3 · apkit lifecycle">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1850" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="p3title" value="The apkit lifecycle" style="text;html=1;align=left;verticalAlign=middle;fontSize=22;fontStyle=1;fontColor=#1a1a1a;" vertex="1" parent="1">
          <mxGeometry x="40" y="24" width="700" height="34" as="geometry" />
        </mxCell>
        <mxCell id="p3sub" value="python -m tools.apkit &amp;lt;command&amp;gt;   (or pip install -e . and just: apkit)" style="text;html=1;align=left;verticalAlign=top;fontSize=12;fontColor=#555555;" vertex="1" parent="1">
          <mxGeometry x="40" y="60" width="900" height="24" as="geometry" />
        </mxCell>
        <mxCell id="s1h" value="apkit new NAME" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontStyle=1;fontColor=#1f3864;" vertex="1" parent="1">
          <mxGeometry x="40" y="130" width="420" height="26" as="geometry" />
        </mxCell>
        <mxCell id="s1" value="Copies plugins/_template into plugins/NAME and rewrites plugin.json.&lt;br&gt;Next: edit the manifest, write SKILL.md." style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=left;spacingLeft=12;spacingTop=6;verticalAlign=top;fontSize=11;fillColor=#ffffff;strokeColor=#5b7fbd;fontColor=#1f3864;" vertex="1" parent="1">
          <mxGeometry x="40" y="156" width="560" height="78" as="geometry" />
        </mxCell>
        <mxCell id="s2h" value="apkit validate" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontStyle=1;fontColor=#1f3864;" vertex="1" parent="1">
          <mxGeometry x="40" y="252" width="420" height="26" as="geometry" />
        </mxCell>
        <mxCell id="s2" value="Lints every plugin against the Agent Skills spec.&lt;br&gt;--strict turns warnings into failures. Errors also block build." style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=left;spacingLeft=12;spacingTop=6;verticalAlign=top;fontSize=11;fillColor=#ffffff;strokeColor=#5b7fbd;fontColor=#1f3864;" vertex="1" parent="1">
          <mxGeometry x="40" y="278" width="560" height="78" as="geometry" />
        </mxCell>
        <mxCell id="s3h" value="apkit build" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontStyle=1;fontColor=#1f3864;" vertex="1" parent="1">
          <mxGeometry x="40" y="374" width="420" height="26" as="geometry" />
        </mxCell>
        <mxCell id="s3" value="Reads targets/*.json, renders dist/&amp;lt;target&amp;gt;/&amp;lt;plugin&amp;gt;/.&lt;br&gt;--target / --plugin / --clean / --dist-dir / --skip-validate.&lt;br&gt;Prints every skip with its reason; writes INSTALL.md." style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=left;spacingLeft=12;spacingTop=6;verticalAlign=top;fontSize=11;fillColor=#ffffff;strokeColor=#5b7fbd;fontColor=#1f3864;" vertex="1" parent="1">
          <mxGeometry x="40" y="400" width="560" height="78" as="geometry" />
        </mxCell>
        <mxCell id="s4h" value="apkit install NAME --target T" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontStyle=1;fontColor=#1f3864;" vertex="1" parent="1">
          <mxGeometry x="40" y="496" width="420" height="26" as="geometry" />
        </mxCell>
        <mxCell id="s4" value="--scope user|project · --into DIR · --link (symlink) · --dry-run.&lt;br&gt;plan() → apply() → record() into .apkit.local.json." style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=left;spacingLeft=12;spacingTop=6;verticalAlign=top;fontSize=11;fillColor=#ffffff;strokeColor=#5b7fbd;fontColor=#1f3864;" vertex="1" parent="1">
          <mxGeometry x="40" y="522" width="560" height="78" as="geometry" />
