          <mxGeometry x="12" y="208" width="276" height="34" as="geometry" />
        </mxCell>
        <mxCell id="src_r5" value="mcp/servers.json   {{PLUGIN_ROOT}}" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;spacingLeft=8;fontSize=11;fillColor=#ffffff;strokeColor=#c2c2c2;verticalAlign=middle;" vertex="1" parent="src">
          <mxGeometry x="12" y="248" width="276" height="34" as="geometry" />
        </mxCell>
        <mxCell id="src_r6" value="scripts/ · tests/ · README.md" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;spacingLeft=8;fontSize=11;fillColor=#ffffff;strokeColor=#c2c2c2;verticalAlign=middle;" vertex="1" parent="src">
          <mxGeometry x="12" y="288" width="276" height="34" as="geometry" />
        </mxCell>
        <mxCell id="srcnote" value="Skills are already written to the Agent Skills spec — no translation at all.&lt;br&gt;Everything else is written once in a neutral dialect and translated on the way out." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;spacingLeft=10;spacingTop=4;verticalAlign=top;fontSize=11;fillColor=#f7f7f7;strokeColor=#b3b3b3;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="40" y="478" width="300" height="62" as="geometry" />
        </mxCell>
        <mxCell id="tgt" value="2 · ADAPTERS   targets/*.json   (data, not code)" style="swimlane;html=1;startSize=36;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;rounded=1;arcSize=4;fillColor=#fff6e0;strokeColor=#c99a1e;fontColor=#7a5b00;swimlaneFillColor=#fffdf7;" vertex="1" parent="1">
          <mxGeometry x="380" y="130" width="260" height="280" as="geometry" />
