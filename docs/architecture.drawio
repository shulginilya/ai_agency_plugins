          <mxGeometry x="40" y="618" width="420" height="26" as="geometry" />
        </mxCell>
        <mxCell id="s5" value="Which harness paths exist on THIS machine, which mappings are&lt;br&gt;unverified, and what the ledger says is installed where." style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=left;spacingLeft=12;spacingTop=6;verticalAlign=top;fontSize=11;fillColor=#ffffff;strokeColor=#5b7fbd;fontColor=#1f3864;" vertex="1" parent="1">
          <mxGeometry x="40" y="644" width="560" height="78" as="geometry" />
        </mxCell>
        <mxCell id="s6h" value="apkit uninstall NAME" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontStyle=1;fontColor=#1f3864;" vertex="1" parent="1">
