<mxfile host="app.diagrams.net" modified="2026-09-04T00:00:00.000Z" agent="apkit-docs" version="24.7.7" type="device">
  <diagram name="1 · How it works">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1850" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="p1title" value="ai_agency_plugins — how it all works" style="text;html=1;align=left;verticalAlign=middle;fontSize=22;fontStyle=1;fontColor=#1a1a1a;" vertex="1" parent="1">
          <mxGeometry x="40" y="24" width="900" height="34" as="geometry" />
        </mxCell>
        <mxCell id="p1sub" value="One portable source per plugin → declarative per-harness adapters → generated bundles → installed where each agent actually looks. Flow is one-way: nothing downstream ever writes back upstream." style="text;html=1;align=left;verticalAlign=top;fontSize=12;fontColor=#555555;" vertex="1" parent="1">
          <mxGeometry x="40" y="60" width="1180" height="40" as="geometry" />
        </mxCell>
        <mxCell id="src" value="1 · SOURCE   plugins/&amp;lt;name&amp;gt;/   (the only source of truth)" style="swimlane;html=1;startSize=36;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;rounded=1;arcSize=4;fillColor=#eef4ff;strokeColor=#5b7fbd;fontColor=#1f3864;swimlaneFillColor=#fbfcff;" vertex="1" parent="1">
          <mxGeometry x="40" y="130" width="300" height="332" as="geometry" />
        </mxCell>
        <mxCell id="src_r0" value="plugin.json — name, version, author, target overrides" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;spacingLeft=8;fontSize=11;fillColor=#ffffff;strokeColor=#c2c2c2;verticalAlign=middle;" vertex="1" parent="src">
          <mxGeometry x="12" y="48" width="276" height="34" as="geometry" />
        </mxCell>
