        </mxCell>
        <mxCell id="dist_r5" value="dist/agents/&amp;lt;plugin&amp;gt;/" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;spacingLeft=8;fontSize=11;fillColor=#ffffff;strokeColor=#c2c2c2;verticalAlign=middle;" vertex="1" parent="dist">
          <mxGeometry x="12" y="238" width="266" height="32" as="geometry" />
        </mxCell>
        <mxCell id="dist_r6" value="INSTALL.md — degradation report" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;spacingLeft=8;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;verticalAlign=middle;fontStyle=1;" vertex="1" parent="dist">
          <mxGeometry x="12" y="276" width="266" height="32" as="geometry" />
        </mxCell>
        <mxCell id="distnote" value="Every dropped or downgraded component is printed at build time&lt;br&gt;and written into INSTALL.md, with the reason." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;spacingLeft=10;spacingTop=4;verticalAlign=top;fontSize=11;fillColor=#f7f7f7;strokeColor=#b3b3b3;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="1020" y="464" width="290" height="58" as="geometry" />
        </mxCell>
        <mxCell id="harn" value="5 · INSTALL   where each harness actually reads" style="swimlane;html=1;startSize=36;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;rounded=1;arcSize=4;fillColor=#fdeaea;strokeColor=#bd5757;fontColor=#7a2020;swimlaneFillColor=#fffbfb;" vertex="1" parent="1">
          <mxGeometry x="1350" y="130" width="440" height="340" as="geometry" />
        </mxCell>
        <mxCell id="harn_r0" value="Claude Code — ~/.claude/skills/&amp;lt;plugin&amp;gt;/ (whole bundle = plugin)  ·  .claude/{skills,commands,agents}" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;spacingLeft=8;fontSize=11;fillColor=#ffffff;strokeColor=#c2c2c2;verticalAlign=middle;" vertex="1" parent="harn">
          <mxGeometry x="12" y="48" width="416" height="42" as="geometry" />
        </mxCell>
        <mxCell id="harn_r1" value="Codex CLI — ~/.agents/skills  ·  ~/.codex/prompts/&amp;lt;c&amp;gt;.md  ·  ~/.codex/config.toml (by hand)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;spacingLeft=8;fontSize=11;fillColor=#ffffff;strokeColor=#c2c2c2;verticalAlign=middle;" vertex="1" parent="harn">
          <mxGeometry x="12" y="96" width="416" height="42" as="geometry" />
        </mxCell>
        <mxCell id="harn_r2" value="Cursor — .cursor/{skills,commands}  ·  .cursor/mcp.json  ·  .agents/skills" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;spacingLeft=8;fontSize=11;fillColor=#ffffff;strokeColor=#c2c2c2;verticalAlign=middle;" vertex="1" parent="harn">
          <mxGeometry x="12" y="144" width="416" height="42" as="geometry" />
        </mxCell>
        <mxCell id="harn_r3" value="OpenCode — .opencode/{skills,command}  ·  opencode.json (merged)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;spacingLeft=8;fontSize=11;fillColor=#ffffff;strokeColor=#c2c2c2;verticalAlign=middle;" vertex="1" parent="harn">
          <mxGeometry x="12" y="192" width="416" height="42" as="geometry" />
        </mxCell>
        <mxCell id="harn_r4" value="Gemini CLI — .gemini/{skills, commands/&amp;lt;c&amp;gt;.toml, settings.json}" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;spacingLeft=8;fontSize=11;fillColor=#ffffff;strokeColor=#c2c2c2;verticalAlign=middle;" vertex="1" parent="harn">
          <mxGeometry x="12" y="240" width="416" height="42" as="geometry" />
        </mxCell>
        <mxCell id="harn_r5" value="GENERIC  .agents/skills  →  read by Codex + Cursor + Gemini CLI + OpenCode" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;spacingLeft=8;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;verticalAlign=middle;fontStyle=1;" vertex="1" parent="harn">
          <mxGeometry x="12" y="288" width="416" height="42" as="geometry" />
        </mxCell>
        <mxCell id="harnnote" value="Placement modes: bundle (whole dir) · children (each entry placed on its own) · merge-json (merged under one key, previous file kept as *.apkit.bak, invalid JSON refused).&lt;br&gt;Scopes: user (home dir) · project (--into, default cwd)." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;spacingLeft=10;spacingTop=4;verticalAlign=top;fontSize=11;fillColor=#f7f7f7;strokeColor=#b3b3b3;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="1350" y="486" width="440" height="74" as="geometry" />
        </mxCell>
        <mxCell id="e1" value="source" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#4d4d4d;endArrow=blockThin;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="src" target="kit">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e2" value="manifest" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#4d4d4d;endArrow=blockThin;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="tgt" target="kit">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e3" value="apkit build" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#4d4d4d;endArrow=blockThin;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="kit" target="dist">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e4" value="apkit install" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#4d4d4d;endArrow=blockThin;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="dist" target="harn">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="fatebox" value="The four fates — declared by the manifest, never guessed" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;spacingLeft=10;spacingTop=4;verticalAlign=top;fontSize=11;fillColor=#f7f7f7;strokeColor=#b3b3b3;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="40" y="610" width="940" height="190" as="geometry" />
        </mxCell>
        <mxCell id="f1" value="native&lt;br&gt;&lt;br&gt;the harness has this concept —&lt;br&gt;rendered in its own dialect" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=center;fontSize=11;fillColor=#d5efd9;strokeColor=#3f8f52;fontColor=#1d5228;" vertex="1" parent="fatebox">
          <mxGeometry x="20" y="46" width="210" height="92" as="geometry" />
        </mxCell>
        <mxCell id="f2" value="emulated&lt;br&gt;&lt;br&gt;close equivalent exists — a subagent&lt;br&gt;becomes a skill, with a preamble&lt;br&gt;explaining the substitution" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=center;fontSize=11;fillColor=#fde9c9;strokeColor=#d79b00;fontColor=#7a4d00;" vertex="1" parent="fatebox">
          <mxGeometry x="245" y="46" width="210" height="92" as="geometry" />
        </mxCell>
        <mxCell id="f3" value="manual&lt;br&gt;&lt;br&gt;config lives in a file apkit refuses&lt;br&gt;to rewrite (Codex config.toml) —&lt;br&gt;a snippet is emitted instead" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=center;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#1f3864;" vertex="1" parent="fatebox">
          <mxGeometry x="470" y="46" width="210" height="92" as="geometry" />
        </mxCell>
        <mxCell id="f4" value="unsupported&lt;br&gt;&lt;br&gt;nothing sensible exists — dropped,&lt;br&gt;reason printed and written&lt;br&gt;into INSTALL.md" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=center;fontSize=11;fillColor=#ededed;strokeColor=#999999;fontColor=#666666;" vertex="1" parent="fatebox">
          <mxGeometry x="695" y="46" width="210" height="92" as="geometry" />
        </mxCell>
        <mxCell id="fatewhy" value="Why this matters: a cross-harness build that quietly drops your hooks is worse than no build at all — you find out only when the thing you thought was enforced wasn&apos;t. Silent drops are treated as bugs." style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontStyle=2;fontColor=#444444;" vertex="1" parent="fatebox">
          <mxGeometry x="20" y="148" width="900" height="30" as="geometry" />
        </mxCell>
        <mxCell id="ledger" value="install ledger  .apkit.local.json  (gitignored)&lt;br&gt;&lt;br&gt;Every install records exactly what it wrote, so apkit uninstall can undo precisely that.&lt;br&gt;Merged config entries are reported, not removed — unpicking a hand-edited config is not&lt;br&gt;something a tool should do unasked." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;spacingLeft=10;spacingTop=4;verticalAlign=top;fontSize=11;fillColor=#f7f7f7;strokeColor=#b3b3b3;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="1020" y="610" width="480" height="120" as="geometry" />
        </mxCell>
