        <mxCell id="c5_1" value="—&lt;br&gt;—" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=center;fontSize=11;fillColor=#ededed;strokeColor=#999999;fontColor=#666666;" vertex="1" parent="1">
