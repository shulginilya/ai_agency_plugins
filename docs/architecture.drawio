        </mxCell>
        <mxCell id="tgt_r5" value="agents.json  — generic .agents/skills" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;spacingLeft=8;fontSize=11;fillColor=#ffffff;strokeColor=#c2c2c2;verticalAlign=middle;" vertex="1" parent="tgt">
          <mxGeometry x="12" y="238" width="236" height="32" as="geometry" />
        </mxCell>
        <mxCell id="tgtnote" value="Each manifest declares, per component:&lt;br&gt;• support: native | emulated | manual | unsupported&lt;br&gt;• path + format (dialect)&lt;br&gt;• placeholder spellings ($ARGUMENTS, {{args}}, …)&lt;br&gt;• install placements (scope + mode)&lt;br&gt;• verified: true|false — checked against the&lt;br&gt;   harness&apos;s own docs, or inferred" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;spacingLeft=10;spacingTop=4;verticalAlign=top;fontSize=11;fillColor=#f7f7f7;strokeColor=#b3b3b3;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="380" y="426" width="260" height="130" as="geometry" />
        </mxCell>
        <mxCell id="kit" value="3 · BUILD   tools/apkit   (Python 3.9+, stdlib only, zero deps)" style="swimlane;html=1;startSize=36;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;rounded=1;arcSize=4;fillColor=#e7f5ea;strokeColor=#3f8f52;fontColor=#1d5228;swimlaneFillColor=#fbfefb;" vertex="1" parent="1">
          <mxGeometry x="680" y="130" width="300" height="356" as="geometry" />
