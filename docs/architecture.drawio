          <mxGeometry x="40" y="528" width="220" height="62" as="geometry" />
        </mxCell>
        <mxCell id="c5_0" value="native&lt;br&gt;SKILL.md" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=center;fontSize=11;fillColor=#d5efd9;strokeColor=#3f8f52;fontColor=#1d5228;" vertex="1" parent="1">
