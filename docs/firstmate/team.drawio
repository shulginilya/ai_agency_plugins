<mxfile host="app.diagrams.net" agent="team_diagram.py" version="24.7.7" type="device">
  <diagram id="page1" name="1 · Team and ownership">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1640" pageHeight="1229" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="p1_t_title" value="&lt;div style=&quot;font-size:22px;&quot;&gt;&lt;b&gt;firstmate crew — who does what&lt;/b&gt;&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontColor=#1a1a1a;strokeWidth=1.2;align=left;verticalAlign=top;spacing=0;fontFamily=Inter;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1400" height="34" as="geometry" /></mxCell>
        <mxCell id="p1_t_sub" value="&lt;div style=&quot;font-size:11px;color:#666666;&quot;&gt;Generated by integrations/firstmate/team_diagram.py from deploy.sh, brief-include.md, plugins/ and team.json — edit those, not this file.&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontColor=#666666;strokeWidth=1.2;align=left;verticalAlign=top;spacing=0;fontFamily=Inter;" vertex="1" parent="1"><mxGeometry x="40" y="56" width="1500" height="24" as="geometry" /></mxCell>
        <mxCell id="p1_lead_captain" value="&lt;div style=&quot;font-size:16px;&quot;&gt;&lt;b&gt;Captain&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:11px;color:#555555;&quot;&gt;&lt;i&gt;You — the human&lt;/i&gt;&lt;/div&gt;&lt;div style=&quot;font-size:9px;color:#777777;margin-top:6px;&quot;&gt;&lt;b&gt;DOES&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:10.5px;&quot;&gt;• Sets the intent for every task&lt;/div&gt;&lt;div style=&quot;font-size:10.5px;&quot;&gt;• Answers the questions a crewmate stops on&lt;/div&gt;&lt;div style=&quot;font-size:10.5px;&quot;&gt;• Approves anything irreversible: deleting a ticket, creating a board, GitHub writes beyond a delivery contract&lt;/div&gt;&lt;div style=&quot;font-size:10.5px;&quot;&gt;• Reviews and merges PRs&lt;/div&gt;&lt;div style=&quot;font-size:9px;color:#777777;margin-top:6px;&quot;&gt;&lt;b&gt;OWNS&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:10.5px;&quot;&gt;• Product intent and priorities&lt;/div&gt;&lt;div style=&quot;font-size:10.5px;&quot;&gt;• Merge decisions&lt;/div&gt;&lt;div style=&quot;font-size:10.5px;&quot;&gt;• Crew deployment (deploy.sh)&lt;/div&gt;&lt;div style=&quot;font-size:10.5px;&quot;&gt;• Captain-only plugins (listed below)&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#fff4e0;strokeColor=#d08a00;fontColor=#5c3d00;strokeWidth=1.6;align=left;verticalAlign=top;spacing=12;fontFamily=Inter;" vertex="1" parent="1"><mxGeometry x="40" y="100" width="420" height="224" as="geometry" /></mxCell>
        <mxCell id="p1_lead_firstmate" value="&lt;div style=&quot;font-size:16px;&quot;&gt;&lt;b&gt;Firstmate&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:11px;color:#555555;&quot;&gt;&lt;i&gt;firstmate orchestrator (~/firstmate)&lt;/i&gt;&lt;/div&gt;&lt;div style=&quot;font-size:9px;color:#777777;margin-top:6px;&quot;&gt;&lt;b&gt;DOES&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:10.5px;&quot;&gt;• Turns the Captain&amp;#x27;s intent into a spec and one brief per task&lt;/div&gt;&lt;div style=&quot;font-size:10.5px;&quot;&gt;• Picks ship (changes code) or scout (read-only)&lt;/div&gt;&lt;div style=&quot;font-size:10.5px;&quot;&gt;• Sets the delivery contract: how far a crewmate may write to remotes&lt;/div&gt;&lt;div style=&quot;font-size:10.5px;&quot;&gt;• Dispatches crewmates, reads their reports, relays open questions&lt;/div&gt;&lt;div style=&quot;font-size:10.5px;&quot;&gt;• Tears a crewmate down when its task ends&lt;/div&gt;&lt;div style=&quot;font-size:9px;color:#777777;margin-top:6px;&quot;&gt;&lt;b&gt;OWNS&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:10.5px;&quot;&gt;• Briefs and delivery contracts&lt;/div&gt;&lt;div style=&quot;font-size:10.5px;&quot;&gt;• Live crew state (state/&amp;lt;id&amp;gt;.meta)&lt;/div&gt;&lt;div style=&quot;font-size:10.5px;&quot;&gt;• Parallelism: how many crewmates run at once&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#e8f0fe;strokeColor=#3c6fd1;fontColor=#1b3a78;strokeWidth=1.6;align=left;verticalAlign=top;spacing=12;fontFamily=Inter;" vertex="1" parent="1"><mxGeometry x="580" y="100" width="420" height="224" as="geometry" /></mxCell>
        <mxCell id="p1_integ" value="&lt;div style=&quot;font-size:14px;&quot;&gt;&lt;b&gt;Integration layer&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:10px;color:#555555;&quot;&gt;&lt;font face=&quot;JetBrains Mono&quot;&gt;integrations/firstmate/ → &amp;lt;firstmate home&amp;gt;/config/&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;font-size:9px;color:#777777;margin-top:6px;&quot;&gt;&lt;b&gt;FILES&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:10.5px;&quot;&gt;• brief-include.md — appended to every ship and scout brief: routes work to plugins, sets unattended rules&lt;/div&gt;&lt;div style=&quot;font-size:10.5px;&quot;&gt;• deploy.sh — copies config; --with-plugins installs exactly the crew_plugins into ~/.claude; refuses while a crewmate is live&lt;/div&gt;&lt;div style=&quot;font-size:10.5px;&quot;&gt;• crew-dispatch.json — planned, not present&lt;/div&gt;&lt;div style=&quot;font-size:10.5px;&quot;&gt;• team.json + team_diagram.py — this diagram&lt;/div&gt;&lt;div style=&quot;font-size:9px;color:#777777;margin-top:6px;&quot;&gt;&lt;b&gt;CREW RULES (FROM BRIEF-INCLUDE.MD)&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:10.5px;&quot;&gt;• Nobody watches the pane: decide from the brief, record why, continue&lt;/div&gt;&lt;div style=&quot;font-size:10.5px;&quot;&gt;• Can&amp;#x27;t decide from the brief: write the question in the report and stop&lt;/div&gt;&lt;div style=&quot;font-size:10.5px;&quot;&gt;• Never guess on anything irreversible&lt;/div&gt;&lt;div style=&quot;font-size:10.5px;&quot;&gt;• Write to remotes only as far as the delivery contract allows&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#fafafa;strokeColor=#c8c8c8;fontColor=#333333;strokeWidth=1.2;align=left;verticalAlign=top;spacing=12;fontFamily=Inter;" vertex="1" parent="1"><mxGeometry x="1120" y="100" width="480" height="234" as="geometry" /></mxCell>
        <mxCell id="p1_e_cf" value="intent" style="edgeStyle=none;html=1;endArrow=block;endFill=1;strokeColor=#d08a00;strokeWidth=1.4;fontSize=10;fontColor=#333333;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="460" y="140" as="sourcePoint" /><mxPoint x="580" y="140" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="p1_e_fc" value="questions, results" style="edgeStyle=none;html=1;endArrow=block;endFill=1;strokeColor=#3c6fd1;strokeWidth=1.4;fontSize=10;fontColor=#333333;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="580" y="190" as="sourcePoint" /><mxPoint x="460" y="190" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="p1_crew_box" value="&lt;div style=&quot;font-size:14px;&quot;&gt;&lt;b&gt;Crew — 4 crew plugins (deploy.sh crew_plugins), each crewmate a Claude Code session&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:10.5px;color:#3a5a46;&quot;&gt;Every crewmate is one Claude Code session with all crew plugins loaded. A role is the plugin brief-include.md routes that kind of work to, so one ship crewmate usually plays Developer, then Code Reviewer, then Developer again. All four share the ticket-management skill, so any crewmate can create, edit and close tickets and move board cards; it deletes one only when its brief names it. Firstmate can run several crewmates side by side.&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f5fbf7;strokeColor=#2e8b57;fontColor=#174d30;strokeWidth=1.2;align=left;verticalAlign=top;spacing=14;fontFamily=Inter;dashed=1;container=0;" vertex="1" parent="1"><mxGeometry x="40" y="404" width="1420" height="572" as="geometry" /></mxCell>
        <mxCell id="p1_crew_developer" value="&lt;div style=&quot;font-size:15px;&quot;&gt;&lt;b&gt;Developer&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:10px;color:#555555;&quot;&gt;developer plugin · v0.3.0 · claude-opus-5-5&lt;/div&gt;&lt;div style=&quot;font-size:9px;color:#777777;margin-top:6px;&quot;&gt;&lt;b&gt;ROUTED HERE WHEN&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:10.5px;&quot;&gt;• Feature, ticket or change&lt;/div&gt;&lt;div style=&quot;font-size:10.5px;&quot;&gt;• Restructure without behaviour change&lt;/div&gt;&lt;div style=&quot;font-size:10.5px;&quot;&gt;• Before pushing&lt;/div&gt;&lt;div style=&quot;font-size:9px;color:#777777;margin-top:6px;&quot;&gt;&lt;b&gt;COMMANDS&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:10.5px;&quot;&gt;&lt;font face=&quot;JetBrains Mono&quot;&gt;/developer:implement&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;font-size:10.5px;&quot;&gt;&lt;font face=&quot;JetBrains Mono&quot;&gt;/developer:refactor&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;font-size:10.5px;&quot;&gt;&lt;font face=&quot;JetBrains Mono&quot;&gt;/developer:ship&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;font-size:10.5px;&quot;&gt;&lt;font face=&quot;JetBrains Mono&quot;&gt;/developer:verify&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;font-size:9px;color:#777777;margin-top:6px;&quot;&gt;&lt;b&gt;SUBAGENT&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:10.5px;&quot;&gt;&lt;font face=&quot;JetBrains Mono&quot;&gt;implementer (claude-opus-5-5)&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;font-size:9px;color:#777777;margin-top:6px;&quot;&gt;&lt;b&gt;SKILLS&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:10.5px;&quot;&gt;&lt;font face=&quot;JetBrains Mono&quot;&gt;feature-implementation&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;font-size:10.5px;&quot;&gt;&lt;font face=&quot;JetBrains Mono&quot;&gt;safe-refactoring&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;font-size:10.5px;&quot;&gt;&lt;font face=&quot;JetBrains Mono&quot;&gt;ship-change&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;font-size:10.5px;&quot;&gt;&lt;font face=&quot;JetBrains Mono&quot;&gt;ticket-management (shared)&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;font-size:9px;color:#777777;margin-top:6px;&quot;&gt;&lt;b&gt;MCP TOOLS&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:10.5px;&quot;&gt;&lt;font face=&quot;JetBrains Mono&quot;&gt;verify_commands, find_callers, dev_playbook&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;font-size:9px;color:#777777;margin-top:6px;&quot;&gt;&lt;b&gt;HOOKS&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:10.5px;&quot;&gt;&lt;font face=&quot;JetBrains Mono&quot;&gt;SessionStart → dev_context.py&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;font-size:9px;color:#777777;margin-top:6px;&quot;&gt;&lt;b&gt;OWNS&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:10.5px;&quot;&gt;• Code changes, built in slices that stay green&lt;/div&gt;&lt;div style=&quot;font-size:10.5px;&quot;&gt;• Repo checks passing before push&lt;/div&gt;&lt;div style=&quot;font-size:10.5px;&quot;&gt;• Branch, PR and the ticket&amp;#x27;s card to In review (/developer:ship)&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#e8f6ee;strokeColor=#2e8b57;fontColor=#174d30;strokeWidth=1.2;align=left;verticalAlign=top;spacing=12;fontFamily=Inter;" vertex="1" parent="1"><mxGeometry x="60" y="474" width="330" height="482" as="geometry" /></mxCell>
        <mxCell id="p1_crew_debugger" value="&lt;div style=&quot;font-size:15px;&quot;&gt;&lt;b&gt;Debugger&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:10px;color:#555555;&quot;&gt;debugger plugin · v0.2.0 · sonnet&lt;/div&gt;&lt;div style=&quot;font-size:9px;color:#777777;margin-top:6px;&quot;&gt;&lt;b&gt;ROUTED HERE WHEN&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:10.5px;&quot;&gt;• Bug, failing or flaky test, wrong output&lt;/div&gt;&lt;div style=&quot;font-size:10.5px;&quot;&gt;• Known-good regression&lt;/div&gt;&lt;div style=&quot;font-size:10.5px;&quot;&gt;• Scout (read-only) tasks&lt;/div&gt;&lt;div style=&quot;font-size:9px;color:#777777;margin-top:6px;&quot;&gt;&lt;b&gt;COMMANDS&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:10.5px;&quot;&gt;&lt;font face=&quot;JetBrains Mono&quot;&gt;/debugger:bisect&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;font-size:10.5px;&quot;&gt;&lt;font face=&quot;JetBrains Mono&quot;&gt;/debugger:diagnose&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;font-size:10.5px;&quot;&gt;&lt;font face=&quot;JetBrains Mono&quot;&gt;/debugger:fix&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;font-size:9px;color:#777777;margin-top:6px;&quot;&gt;&lt;b&gt;SUBAGENT&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:10.5px;&quot;&gt;&lt;font face=&quot;JetBrains Mono&quot;&gt;investigator (sonnet)&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;font-size:9px;color:#777777;margin-top:6px;&quot;&gt;&lt;b&gt;SKILLS&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:10.5px;&quot;&gt;&lt;font face=&quot;JetBrains Mono&quot;&gt;regression-triage&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;font-size:10.5px;&quot;&gt;&lt;font face=&quot;JetBrains Mono&quot;&gt;root-cause-analysis&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;font-size:10.5px;&quot;&gt;&lt;font face=&quot;JetBrains Mono&quot;&gt;ticket-management (shared)&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;font-size:9px;color:#777777;margin-top:6px;&quot;&gt;&lt;b&gt;MCP TOOLS&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:10.5px;&quot;&gt;&lt;font face=&quot;JetBrains Mono&quot;&gt;repro_command, change_history, bug_playbook&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;font-size:9px;color:#777777;margin-top:6px;&quot;&gt;&lt;b&gt;HOOKS&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:10.5px;&quot;&gt;&lt;font face=&quot;JetBrains Mono&quot;&gt;PostToolUse(Write|Edit) → symptom_suppression_check.py&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;font-size:9px;color:#777777;margin-top:6px;&quot;&gt;&lt;b&gt;OWNS&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:10.5px;&quot;&gt;• A proved root cause before any fix&lt;/div&gt;&lt;div style=&quot;font-size:10.5px;&quot;&gt;• The failing regression test, written first&lt;/div&gt;&lt;div style=&quot;font-size:10.5px;&quot;&gt;• The first bad commit of a regression&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#e8f6ee;strokeColor=#2e8b57;fontColor=#174d30;strokeWidth=1.2;align=left;verticalAlign=top;spacing=12;fontFamily=Inter;" vertex="1" parent="1"><mxGeometry x="410" y="474" width="330" height="482" as="geometry" /></mxCell>
        <mxCell id="p1_crew_code-review" value="&lt;div style=&quot;font-size:15px;&quot;&gt;&lt;b&gt;Code Reviewer&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:10px;color:#555555;&quot;&gt;code-review plugin · v0.2.0 · claude-opus-5-5&lt;/div&gt;&lt;div style=&quot;font-size:9px;color:#777777;margin-top:6px;&quot;&gt;&lt;b&gt;ROUTED HERE WHEN&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:10.5px;&quot;&gt;• Before pushing&lt;/div&gt;&lt;div style=&quot;font-size:10.5px;&quot;&gt;• Scout (read-only) tasks&lt;/div&gt;&lt;div style=&quot;font-size:9px;color:#777777;margin-top:6px;&quot;&gt;&lt;b&gt;COMMANDS&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:10.5px;&quot;&gt;&lt;font face=&quot;JetBrains Mono&quot;&gt;/code-review:review-pr&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;font-size:10.5px;&quot;&gt;&lt;font face=&quot;JetBrains Mono&quot;&gt;/code-review:review&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;font-size:9px;color:#777777;margin-top:6px;&quot;&gt;&lt;b&gt;SUBAGENT&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:10.5px;&quot;&gt;&lt;font face=&quot;JetBrains Mono&quot;&gt;reviewer (claude-opus-5-5)&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;font-size:9px;color:#777777;margin-top:6px;&quot;&gt;&lt;b&gt;SKILLS&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:10.5px;&quot;&gt;&lt;font face=&quot;JetBrains Mono&quot;&gt;code-review&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;font-size:10.5px;&quot;&gt;&lt;font face=&quot;JetBrains Mono&quot;&gt;pr-audit&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;font-size:10.5px;&quot;&gt;&lt;font face=&quot;JetBrains Mono&quot;&gt;ticket-management (shared)&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;font-size:9px;color:#777777;margin-top:6px;&quot;&gt;&lt;b&gt;MCP TOOLS&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:10.5px;&quot;&gt;&lt;font face=&quot;JetBrains Mono&quot;&gt;changed_files, review_checklist&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;font-size:9px;color:#777777;margin-top:6px;&quot;&gt;&lt;b&gt;HOOKS&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:10.5px;&quot;&gt;&lt;font face=&quot;JetBrains Mono&quot;&gt;PostToolUse(Write|Edit) → post_edit_check.py&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;font-size:9px;color:#777777;margin-top:6px;&quot;&gt;&lt;b&gt;OWNS&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:10.5px;&quot;&gt;• Severity-ranked findings on every diff before push&lt;/div&gt;&lt;div style=&quot;font-size:10.5px;&quot;&gt;• Ship / ship-with-changes / hold verdict on a PR (scout)&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#e8f6ee;strokeColor=#2e8b57;fontColor=#174d30;strokeWidth=1.2;align=left;verticalAlign=top;spacing=12;fontFamily=Inter;" vertex="1" parent="1"><mxGeometry x="760" y="474" width="330" height="482" as="geometry" /></mxCell>
        <mxCell id="p1_crew_scrum-master" value="&lt;div style=&quot;font-size:15px;&quot;&gt;&lt;b&gt;Scrum Master&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:10px;color:#555555;&quot;&gt;scrum-master plugin · v0.3.0 · claude-opus-5-5, sonnet&lt;/div&gt;&lt;div style=&quot;font-size:9px;color:#777777;margin-top:6px;&quot;&gt;&lt;b&gt;ROUTED HERE WHEN&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:10.5px;&quot;&gt;• Backlog or issue grooming&lt;/div&gt;&lt;div style=&quot;font-size:10.5px;&quot;&gt;• New project board&lt;/div&gt;&lt;div style=&quot;font-size:9px;color:#777777;margin-top:6px;&quot;&gt;&lt;b&gt;COMMANDS&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:10.5px;&quot;&gt;&lt;font face=&quot;JetBrains Mono&quot;&gt;/scrum-master:backlog-health&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;font-size:10.5px;&quot;&gt;&lt;font face=&quot;JetBrains Mono&quot;&gt;/scrum-master:create-board&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;font-size:10.5px;&quot;&gt;&lt;font face=&quot;JetBrains Mono&quot;&gt;/scrum-master:plan-sprint&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;font-size:10.5px;&quot;&gt;&lt;font face=&quot;JetBrains Mono&quot;&gt;/scrum-master:refine&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;font-size:9px;color:#777777;margin-top:6px;&quot;&gt;&lt;b&gt;SUBAGENT&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:10.5px;&quot;&gt;&lt;font face=&quot;JetBrains Mono&quot;&gt;story-splitter (sonnet)&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;font-size:9px;color:#777777;margin-top:6px;&quot;&gt;&lt;b&gt;SKILLS&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:10.5px;&quot;&gt;&lt;font face=&quot;JetBrains Mono&quot;&gt;backlog-refinement&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;font-size:10.5px;&quot;&gt;&lt;font face=&quot;JetBrains Mono&quot;&gt;board-setup&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;font-size:10.5px;&quot;&gt;&lt;font face=&quot;JetBrains Mono&quot;&gt;sprint-planning&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;font-s