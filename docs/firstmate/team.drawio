        <mxCell id="p3_lanel_code-review" value="&lt;div style=&quot;font-size:13px;&quot;&gt;&lt;b&gt;Code Reviewer&lt;/b&gt;&lt;/div&gt;" style="rounded=0;arcSize=6;whiteSpace=wrap;html=1;fillColor=#e8f6ee;strokeColor=#2e8b57;fontColor=#174d30;strokeWidth=1.2;align=center;verticalAlign=middle;spacing=10;fontFamily=Inter;" vertex="1" parent="1"><mxGeometry x="40" y="659" width="150" height="112" as="geometry" /></mxCell>
        <mxCell id="p3_lane_debugger" value="" style="rounded=0;arcSize=6;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#d6d6d6;fontColor=#333;strokeWidth=1.2;align=left;verticalAlign=top;spacing=10;fontFamily=Inter;" vertex="1" parent="1"><mxGeometry x="40" y="771" width="3750" height="112" as="geometry" /></mxCell>
        <mxCell id="p3_lanel_debugger" value="&lt;div style=&quot;font-size:13px;&quot;&gt;&lt;b&gt;Debugger&lt;/b&gt;&lt;/div&gt;" style="rounded=0;arcSize=6;whiteSpace=wrap;html=1;fillColor=#e8f6ee;strokeColor=#2e8b57;fontColor=#174d30;strokeWidth=1.2;align=center;verticalAlign=middle;spacing=10;fontFamily=Inter;" vertex="1" parent="1"><mxGeometry x="40" y="771" width="150" height="112" as="geometry" /></mxCell>
        <mxCell id="p3_st_s1" value="&lt;div style=&quot;font-size:9px;color:#d08a00;&quot;&gt;&lt;b&gt;1&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:11.5px;&quot;&gt;Intent: new project X. Create its board and a first backlog from these notes&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#fff4e0;strokeColor=#d08a00;fontColor=#5c3d00;strokeWidth=1.2;align=left;verticalAlign=top;spacing=8;fontFamily=Inter;" vertex="1" parent="1"><mxGeometry x="202" y="138" width="186" height="91" as="geometry" /></mxCell>
        <mxCell id="p3_st_s2" value="&lt;div style=&quot;font-size:9px;color:#3c6fd1;&quot;&gt;&lt;b&gt;2&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:11.5px;&quot;&gt;Spec, then a scout brief T1: draft the backlog and propose the board. No writes yet&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#e8f0fe;strokeColor=#3c6fd1;fontColor=#1b3a78;strokeWidth=1.2;align=left;verticalAlign=top;spacing=8;fontFamily=Inter;" vertex="1" parent="1"><mxGeometry x="412" y="265" width="186" height="91" as="geometry" /></mxCell>
        <mxCell id="p3_st_s3" value="&lt;div style=&quot;font-size:9px;color:#2e8b57;&quot;&gt;&lt;b&gt;3&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:11.5px;&quot;&gt;/scrum-master:refine each raw idea → user-value story, testable criteria, size&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#e8f6ee;strokeColor=#2e8b57;fontColor=#174d30;strokeWidth=1.2;align=left;verticalAlign=top;spacing=8;fontFamily=Inter;" vertex="1" parent="1"><mxGeometry x="622" y="400" width="186" height="91" as="geometry" /></mxCell>
        <mxCell id="p3_st_s4" value="&lt;div style=&quot;font-size:9px;color:#2e8b57;&quot;&gt;&lt;b&gt;4&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:11.5px;&quot;&gt;story-splitter subagent splits 13+ items; readiness check on each story&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#e8f6ee;strokeColor=#2e8b57;fontColor=#174d30;strokeWidth=1.2;align=left;verticalAlign=top;spacing=8;fontFamily=Inter;" vertex="1" parent="1"><mxGeometry x="832" y="400" width="186" height="91" as="geometry" /></mxCell>
        <mxCell id="p3_st_s5" value="&lt;div style=&quot;font-size:9px;color:#2e8b57;&quot;&gt;&lt;b&gt;5&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:11.5px;&quot;&gt;Plan file for tickets.py batch --dry-run; /scrum-master:create-board --dry-run. Both go in the report&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#e8f6ee;strokeColor=#2e8b57;fontColor=#174d30;strokeWidth=1.2;align=left;verticalAlign=top;spacing=8;fontFamily=Inter;" vertex="1" parent="1"><mxGeometry x="1042" y="392" width="186" height="107" as="geometry" /></mxCell>
        <mxCell id="p3_st_s6" value="&lt;div style=&quot;font-size:9px;color:#3c6fd1;&quot;&gt;&lt;b&gt;6&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:11.5px;&quot;&gt;Relay the backlog, the board plan and open questions&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#e8f0fe;strokeColor=#3c6fd1;fontColor=#1b3a78;strokeWidth=1.2;align=left;verticalAlign=top;spacing=8;fontFamily=Inter;" vertex="1" parent="1"><mxGeometry x="1252" y="273" width="186" height="76" as="geometry" /></mxCell>
        <mxCell id="p3_st_s7" value="&lt;div style=&quot;font-size:9px;color:#d08a00;&quot;&gt;&lt;b&gt;7&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:11.5px;&quot;&gt;Answer questions, approve the board and the backlog&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#fff4e0;strokeColor=#d08a00;fontColor=#5c3d00;strokeWidth=1.2;align=left;verticalAlign=top;spacing=8;fontFamily=Inter;" vertex="1" parent="1"><mxGeometry x="1462" y="149" width="186" height="69" as="geometry" /></mxCell>
        <mxCell id="p3_st_s8" value="&lt;div style=&quot;font-size:9px;color:#3c6fd1;&quot;&gt;&lt;b&gt;8&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:11.5px;&quot;&gt;Brief T2: create the board, then file the approved plan on it&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#e8f0fe;strokeColor=#3c6fd1;fontColor=#1b3a78;strokeWidth=1.2;align=left;verticalAlign=top;spacing=8;fontFamily=Inter;" vertex="1" parent="1"><mxGeometry x="1672" y="273" width="186" height="76" as="geometry" /></mxCell>
        <mxCell id="p3_st_s9" value="&lt;div style=&quot;font-size:9px;color:#8e44ad;&quot;&gt;&lt;b&gt;9&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:11.5px;&quot;&gt;/scrum-master:create-board → board N, columns Backlog → Ready → In progress → In review → Done&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f3e8fd;strokeColor=#8e44ad;fontColor=#4a1f63;strokeWidth=1.2;align=left;verticalAlign=top;spacing=8;fontFamily=Inter;" vertex="1" parent="1"><mxGeometry x="1882" y="400" width="186" height="91" as="geometry" /></mxCell>
        <mxCell id="p3_st_s10" value="&lt;div style=&quot;font-size:9px;color:#8e44ad;&quot;&gt;&lt;b&gt;10&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:11.5px;&quot;&gt;tickets.py batch --plan plan.json --project N --status Ready (safe to rerun; slices linked to epics)&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f3e8fd;strokeColor=#8e44ad;fontColor=#4a1f63;strokeWidth=1.2;align=left;verticalAlign=top;spacing=8;fontFamily=Inter;" vertex="1" parent="1"><mxGeometry x="2092" y="392" width="186" height="107" as="geometry" /></mxCell>
        <mxCell id="p3_st_s11" value="&lt;div style=&quot;font-size:9px;color:#2e8b57;&quot;&gt;&lt;b&gt;11&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:11.5px;&quot;&gt;/scrum-master:plan-sprint → sprint goal, capacity, issues that fit (proposal)&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#e8f6ee;strokeColor=#2e8b57;fontColor=#174d30;strokeWidth=1.2;align=left;verticalAlign=top;spacing=8;fontFamily=Inter;" vertex="1" parent="1"><mxGeometry x="2302" y="408" width="186" height="76" as="geometry" /></mxCell>
        <mxCell id="p3_st_s12" value="&lt;div style=&quot;font-size:9px;color:#d08a00;&quot;&gt;&lt;b&gt;12&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:11.5px;&quot;&gt;Approve sprint 1&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#fff4e0;strokeColor=#d08a00;fontColor=#5c3d00;strokeWidth=1.2;align=left;verticalAlign=top;spacing=8;fontFamily=Inter;" vertex="1" parent="1"><mxGeometry x="2512" y="149" width="186" height="69" as="geometry" /></mxCell>
        <mxCell id="p3_st_s13" value="&lt;div style=&quot;font-size:9px;color:#3c6fd1;&quot;&gt;&lt;b&gt;13&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:11.5px;&quot;&gt;One ship brief per sprint ticket&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#e8f0fe;strokeColor=#3c6fd1;fontColor=#1b3a78;strokeWidth=1.2;align=left;verticalAlign=top;spacing=8;fontFamily=Inter;" vertex="1" parent="1"><mxGeometry x="2722" y="276" width="186" height="69" as="geometry" /></mxCell>
        <mxCell id="p3_st_s14" value="&lt;div style=&quot;font-size:9px;color:#2e8b57;&quot;&gt;&lt;b&gt;14&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:11.5px;&quot;&gt;/developer:implement&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#e8f6ee;strokeColor=#2e8b57;fontColor=#174d30;strokeWidth=1.2;align=left;verticalAlign=top;spacing=8;fontFamily=Inter;" vertex="1" parent="1"><mxGeometry x="2932" y="554" width="186" height="69" as="geometry" /></mxCell>
        <mxCell id="p3_st_s15" value="&lt;div style=&quot;font-size:9px;color:#2e8b57;&quot;&gt;&lt;b&gt;15&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:11.5px;&quot;&gt;/code-review:review own diff; fix every high-severity finding&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#e8f6ee;strokeColor=#2e8b57;fontColor=#174d30;strokeWidth=1.2;align=left;verticalAlign=top;spacing=8;fontFamily=Inter;" vertex="1" parent="1"><mxGeometry x="3142" y="677" width="186" height="76" as="geometry" /></mxCell>
        <mxCell id="p3_st_s16" value="&lt;div style=&quot;font-size:9px;color:#8a8a8a;&quot;&gt;&lt;b&gt;16&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:11.5px;&quot;&gt;Only if a test fails: /debugger:diagnose → /debugger:fix&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f4f4f4;strokeColor=#8a8a8a;fontColor=#333333;strokeWidth=1.2;align=left;verticalAlign=top;spacing=8;fontFamily=Inter;dashed=1;" vertex="1" parent="1"><mxGeometry x="3142" y="789" width="186" height="76" as="geometry" /></mxCell>
        <mxCell id="p3_st_s17" value="&lt;div style=&quot;font-size:9px;color:#8e44ad;&quot;&gt;&lt;b&gt;17&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:11.5px;&quot;&gt;/developer:verify, then /developer:ship → branch, PR, card to In review. Follow-up tickets with ticket-management&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f3e8fd;strokeColor=#8e44ad;fontColor=#4a1f63;strokeWidth=1.2;align=left;verticalAlign=top;spacing=8;fontFamily=Inter;" vertex="1" parent="1"><mxGeometry x="3352" y="535" width="186" height="107" as="geometry" /></mxCell>
        <mxCell id="p3_st_s18" value="&lt;div style=&quot;font-size:9px;color:#d08a00;&quot;&gt;&lt;b&gt;18&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:11.5px;&quot;&gt;Review and merge&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#fff4e0;strokeColor=#d08a00;fontColor=#5c3d00;strokeWidth=1.2;align=left;verticalAlign=top;spacing=8;fontFamily=Inter;" vertex="1" parent="1"><mxGeometry x="3562" y="149" width="186" height="69" as="geometry" /></mxCell>
