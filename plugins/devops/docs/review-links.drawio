<mxfile host="app.diagrams.net" agent="hand-drawn" version="24.7.7" type="device">
  <diagram id="p1" name="1 · How a review link is made">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1540" pageHeight="840" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="p1_title" value="&lt;b style=&#x27;font-size:20px;&#x27;&gt;Review links: devops makes them, QA tests the latest one&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;fontFamily=Inter, Segoe UI, Helvetica, Arial, sans-serif;fontSize=12;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1300" height="30" as="geometry" /></mxCell>
        <mxCell id="p1_sub" value="One PR, one review link: &lt;code&gt;https://&amp;lt;branch&amp;gt;.&amp;lt;slug&amp;gt;.&amp;lt;REVIEW_DOMAIN&amp;gt;&lt;/code&gt;. &lt;i&gt;review.com&lt;/i&gt; is a placeholder until the domain is chosen (ticket #82). Without REVIEW_DOMAIN the link is the host&#x27;s own address." style="text;html=1;whiteSpace=wrap;fontFamily=Inter, Segoe UI, Helvetica, Arial, sans-serif;fontSize=11;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="40" y="54" width="1300" height="40" as="geometry" /></mxCell>
        <mxCell id="p1_captain" value="&lt;b&gt;Captain: one-time setup&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px;&#x27;&gt;domain zone on Cloudflare (#82)&lt;br&gt;API token: Pages edit + DNS edit&lt;br&gt;&lt;code&gt;gh secret set CLOUDFLARE_API_TOKEN / _ACCOUNT_ID / _ZONE_ID&lt;/code&gt;&lt;br&gt;repo variable &lt;code&gt;REVIEW_DOMAIN&lt;/code&gt; (+ optional &lt;code&gt;REVIEW_SLUG&lt;/code&gt;)&lt;br&gt;crew never sees a secret value&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontFamily=Inter, Segoe UI, Helvetica, Arial, sans-serif;fontSize=12;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="40" y="110" width="300" height="150" as="geometry" /></mxCell>
        <mxCell id="p1_dev" value="&lt;b&gt;Developer: /developer:ship&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px;&#x27;&gt;PR whose body says &lt;code&gt;Closes #N&lt;/code&gt;, every push to it&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontFamily=Inter, Segoe UI, Helvetica, Arial, sans-serif;fontSize=12;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="40" y="300" width="300" height="80" as="geometry" /></mxCell>
        <mxCell id="p1_wf" value="&lt;b&gt;preview.yml (GitHub Actions)&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px;&#x27;&gt;written once by &lt;code&gt;/devops:preview&lt;/code&gt;&lt;br&gt;on PR opened / pushed / closed&lt;br&gt;build with the repo&#x27;s own commands&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontFamily=Inter, Segoe UI, Helvetica, Arial, sans-serif;fontSize=12;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="420" y="300" width="300" height="110" as="geometry" /></mxCell>
        <mxCell id="p1_pages" value="&lt;b&gt;Cloudflare Pages&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px;&#x27;&gt;&lt;code&gt;wrangler pages deploy --branch=pr-&amp;lt;N&amp;gt;&lt;/code&gt;&lt;br&gt;→ &lt;code&gt;pr-&amp;lt;N&amp;gt;.&amp;lt;project&amp;gt;.pages.dev&lt;/code&gt;&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontFamily=Inter, Segoe UI, Helvetica, Arial, sans-serif;fontSize=12;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="820" y="110" width="280" height="80" as="geometry" /></mxCell>
        <mxCell id="p1_dns" value="&lt;b&gt;Review domain (if REVIEW_DOMAIN)&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px;&#x27;&gt;Pages custom domain &lt;code&gt;&amp;lt;branch&amp;gt;.&amp;lt;slug&amp;gt;.&amp;lt;domain&amp;gt;&lt;/code&gt;&lt;br&gt;+ proxied CNAME → &lt;code&gt;pr-&amp;lt;N&amp;gt;.&amp;lt;project&amp;gt;.pages.dev&lt;/code&gt;&lt;br&gt;removed when the PR closes&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontFamily=Inter, Segoe UI, Helvetica, Arial, sans-serif;fontSize=12;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="820" y="220" width="280" height="100" as="geometry" /></mxCell>
        <mxCell id="p1_deploy" value="&lt;b&gt;GitHub Deployment preview-pr-&amp;amp;lt;N&amp;amp;gt;&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px;&#x27;&gt;&lt;code&gt;environment_url&lt;/code&gt; = the link, &lt;code&gt;ref&lt;/code&gt; = head commit&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontFamily=Inter, Segoe UI, Helvetica, Arial, sans-serif;fontSize=12;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="820" y="350" width="280" height="80" as="geometry" /></mxCell>
        <mxCell id="p1_prc" value="&lt;b&gt;PR comment (sticky)&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px;&#x27;&gt;&lt;code&gt;&amp;lt;!-- devops:preview --&amp;gt;&lt;/code&gt;&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontFamily=Inter, Segoe UI, Helvetica, Arial, sans-serif;fontSize=12;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="820" y="460" width="280" height="60" as="geometry" /></mxCell>
        <mxCell id="p1_tix" value="&lt;b&gt;Ticket comment, one per ticket the PR closes&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px;&#x27;&gt;edited on every deploy:&lt;br&gt;&lt;code&gt;&amp;lt;!-- devops:review-link link=… commit=&amp;lt;sha&amp;gt; pr=&amp;lt;N&amp;gt; state=live --&amp;gt;&lt;/code&gt;&lt;br&gt;&lt;code&gt;state=down&lt;/code&gt; once the PR closes&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontFamily=Inter, Segoe UI, Helvetica, Arial, sans-serif;fontSize=12;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="820" y="550" width="280" height="120" as="geometry" /></mxCell>
        <mxCell id="p1_render" value="&lt;b&gt;Render (server apps)&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px;&#x27;&gt;Render deploys each PR itself and reports a Deployment&lt;br&gt;&lt;code&gt;review-link.yml&lt;/code&gt; on &lt;code&gt;deployment_status&lt;/code&gt; writes the same ticket comment&lt;br&gt;no custom domain: link stays &lt;code&gt;*.onrender.com&lt;/code&gt;&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontFamily=Inter, Segoe UI, Helvetica, Arial, sans-serif;fontSize=12;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="420" y="470" width="300" height="110" as="geometry" /></mxCell>
        <mxCell id="p1_rl" value="&lt;b&gt;QA: review_link.py&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px;&#x27;&gt;reads the ticket: newest link wins&lt;br&gt;commit the link serves = marker&#x27;s &lt;code&gt;commit&lt;/code&gt;&lt;br&gt;→ wait · test · retest · up-to-date · none&lt;br&gt;(page 2)&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontFamily=Inter, Segoe UI, Helvetica, Arial, sans-serif;fontSize=12;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="1180" y="550" width="300" height="120" as="geometry" /></mxCell>
        <mxCell id="p1_pl" value="&lt;b&gt;QA fallback: preview_link.py&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px;&#x27;&gt;no link on the ticket → the PR&#x27;s Deployment;&lt;br&gt;also checks which commit a pasted link serves&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontFamily=Inter, Segoe UI, Helvetica, Arial, sans-serif;fontSize=12;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="1180" y="350" width="300" height="80" as="geometry" /></mxCell>
        <mxCell id="p1_verdict" value="&lt;b&gt;QA verdict comment&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px;&#x27;&gt;&lt;code&gt;&amp;lt;!-- qa:verdict verdict=… link=… commit=… --&amp;gt;&lt;/code&gt;&lt;br&gt;accept → Ready for Merge · reject → In progress&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontFamily=Inter, Segoe UI, Helvetica, Arial, sans-serif;fontSize=12;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="1180" y="720" width="300" height="80" as="geometry" /></mxCell>
        <mxCell id="p1_human" value="&lt;b&gt;Anyone may paste a link&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px;&#x27;&gt;in the ticket description or a comment&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#999999;dashed=1;fontFamily=Inter, Segoe UI, Helvetica, Arial, sans-serif;fontSize=12;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="820" y="720" width="280" height="60" as="geometry" /></mxCell>
        <mxCell id="p1_e1" value="secrets + variable" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontFamily=Inter, Segoe UI, Helvetica, Arial, sans-serif;fontSize=10;dashed=1;" edge="1" parent="1" source="p1_captain" target="p1_wf"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="p1_e2" value="push" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontFamily=Inter, Segoe UI, Helvetica, Arial, sans-serif;fontSize=10;" edge="1" parent="1" source="p1_dev" target="p1_wf"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="p1_e3" value="1 deploy" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontFamily=Inter, Segoe UI, Helvetica, Arial, sans-serif;fontSize=10;" edge="1" parent="1" source="p1_wf" target="p1_pages"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="p1_e4" value="2 domain + CNAME" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontFamily=Inter, Segoe UI, Helvetica, Arial, sans-serif;fontSize=10;" edge="1" parent="1" source="p1_wf" target="p1_dns"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="p1_e5" value="3 publish" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontFamily=Inter, Segoe UI, Helvetica, Arial, sans-serif;fontSize=10;" edge="1" parent="1" source="p1_wf" target="p1_deploy"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="p1_e6" value="4" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontFamily=Inter, Segoe UI, Helvetica, Arial, sans-serif;fontSize=10;" edge="1" parent="1" source="p1_wf" target="p1_prc"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="p1_e7" value="5 tickets from Closes #N" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontFamily=Inter, Segoe UI, Helvetica, Arial, sans-serif;fontSize=10;" edge="1" parent="1" source="p1_wf" target="p1_tix"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="p1_e8" value="same comment" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontFamily=Inter, Segoe UI, Helvetica, Arial, sans-serif;fontSize=10;" edge="1" parent="1" source="p1_render" target="p1_tix"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="p1_e9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontFamily=Inter, Segoe UI, Helvetica, Arial, sans-serif;fontSize=10;" edge="1" parent="1" source="p1_tix" target="p1_rl"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="p1_e10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontFamily=Inter, Segoe UI, Helvetica, Arial, sans-serif;fontSize=10;dashed=1;" edge="1" parent="1" source="p1_human" target="p1_rl"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="p1_e11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontFamily=Inter, Segoe UI, Helvetica, Arial, sans-serif;fontSize=10;" edge="1" parent="1" source="p1_deploy" target="p1_pl"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="p1_e12" value="after testing" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontFamily=Inter, Segoe UI, Helvetica, Arial, sans-serif;fontSize=10;" edge="1" parent="1" source="p1_rl" target="p1_verdict"><mxGeometry relative="1" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="p2" name="2 · How QA picks the latest version">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="820" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="p2_title" value="&lt;b style=&#x27;font-size:20px;&#x27;&gt;review_link.py --issue &amp;lt;ticket&amp;gt; --pr &amp;lt;PR&amp;gt; --wait 600&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;fontFamily=Inter, Segoe UI, Helvetica, Arial, sans-serif;fontSize=12;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1300" height="30" as="geometry" /></mxCell>
        <mxCell id="p2_sub" value="The commit under test is the PR&#x27;s head (or &lt;code&gt;--commit&lt;/code&gt;). The decision, top to bottom:" style="text;html=1;whiteSpace=wrap;fontFamily=Inter, Segoe UI, Helvetica, Arial, sans-serif;fontSize=11;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="40" y="54" width="1300" height="30" as="geometry" /></mxCell>
        <mxCell id="p2_s" value="&lt;b&gt;1 · Newest link on the ticket&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px;&#x27;&gt;devops comment counts as of its &lt;b&gt;last edit&lt;/b&gt;&lt;br&gt;pasted link counts as of when it was &lt;b&gt;posted&lt;/b&gt;&lt;br&gt;QA&#x27;s own verdict comments never count&lt;br&gt;&lt;code&gt;state=down&lt;/code&gt; = no link&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontFamily=Inter, Segoe UI, Helvetica, Arial, sans-serif;fontSize=12;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="40" y="100" width="320" height="110" as="geometry" /></mxCell>
        <mxCell id="p2_none" value="&lt;b&gt;none&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px;&#x27;&gt;use the PR&#x27;s preview (preview_link.py, only if current), else test locally&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#999999;dashed=1;fontFamily=Inter, Segoe UI, Helvetica, Arial, sans-serif;fontSize=12;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="40" y="260" width="320" height="70" as="geometry" /></mxCell>
        <mxCell id="p2_serves" value="&lt;b&gt;2 · Does the link serve the commit under test?&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px;&#x27;&gt;known from the devops marker&lt;br&gt;a pasted link: unknown → check with preview_link.py&lt;/span&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontFamily=Inter, Segoe UI, Helvetica, Arial, sans-serif;fontSize=11;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="440" y="100" width="320" height="110" as="geometry" /></mxCell>
        <mxCell id="p2_wait" value="&lt;b&gt;wait&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px;&#x27;&gt;the new build hasn&#x27;t landed: never test it&lt;br&gt;&lt;code&gt;--wait&lt;/code&gt; polls; exit 3 = stuck, report it&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontFamily=Inter, Segoe UI, Helvetica, Arial, sans-serif;fontSize=12;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="440" y="260" width="320" height="80" as="geometry" /></mxCell>
        <mxCell id="p2_v" value="&lt;b&gt;3 · Is there a QA verdict?&lt;/b&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontFamily=Inter, Segoe UI, Helvetica, Arial, sans-serif;fontSize=11;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="840" y="100" width="320" height="110" as="geometry" /></mxCell>
        <mxCell id="p2_test" value="&lt;b&gt;test&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px;&#x27;&gt;every case on that link&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontFamily=Inter, Segoe UI, Helvetica, Arial, sans-serif;fontSize=12;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="840" y="260" width="320" height="60" as="geometry" /></mxCell>
        <mxCell id="p2_same" value="&lt;b&gt;4 · Same link and commit as the verdict?&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px;&#x27;&gt;and no link pasted after it&lt;/span&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontFamily=Inter, Segoe UI, Helvetica, Arial, sans-serif;fontSize=11;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="1240" y="100" width="320" height="110" as="geometry" /></mxCell>
        <mxCell id="p2_retest" value="&lt;b&gt;retest&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px;&#x27;&gt;every case again&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontFamily=Inter, Segoe UI, Helvetica, Arial, sans-serif;fontSize=12;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="1240" y="260" width="150" height="70" as="geometry" /></mxCell>
        <mxCell id="p2_upto" value="&lt;b&gt;up-to-date&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px;&#x27;&gt;nothing new: stop&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#999999;dashed=1;fontFamily=Inter, Segoe UI, Helvetica, Arial, sans-serif;fontSize=12;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="1410" y="260" width="150" height="70" as="geometry" /></mxCell>
        <mxCell id="p2_e1" value="no link" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontFamily=Inter, Segoe UI, Helvetica, Arial, sans-serif;fontSize=10;" edge="1" parent="1" source="p2_s" target="p2_none"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="p2_e2" value="a link" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontFamily=Inter, Segoe UI, Helvetica, Arial, sans-serif;fontSize=10;" edge="1" parent="1" source="p2_s" target="p2_serves"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="p2_e3" value="older commit" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontFamily=Inter, Segoe UI, Helvetica, Arial, sans-serif;fontSize=10;" edge="1" parent="1" source="p2_serves" target="p2_wait"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="p2_e4" value="yes / unknown" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontFamily=Inter, Segoe UI, Helvetica, Arial, sans-serif;fontSize=10;" edge="1" parent="1" source="p2_serves" target="p2_v"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="p2_e5" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontFamily=Inter, Segoe UI, Helvetica, Arial, sans-serif;fontSize=10;" edge="1" parent="1" source="p2_v" target="p2_test"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="p2_e6" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontFamily=Inter, Segoe UI, Helvetica, Arial, sans-serif;fontSize=10;" edge="1" parent="1" source="p2_v" target="p2_same"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="p2_e7" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontFamily=Inter, Segoe UI, Helvetica, Arial, sans-serif;fontSize=10;" edge="1" parent="1" source="p2_same" target="p2_retest"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="p2_e8" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontFamily=Inter, Segoe UI, Helvetica, Arial, sans-serif;fontSize=10;" edge="1" parent="1" source="p2_same" target="p2_upto"><mxGeometry relative="1" as="geometry" /></mxCell>
