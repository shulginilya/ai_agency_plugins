        <mxCell id="bv0" value="→ send it, or say why it can't go" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=11;fontColor=#555555;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="1430" y="430" width="370" height="36" as="geometry" /></mxCell>
        <mxCell id="bk1" value="&lt;b&gt;approve?&lt;/b&gt;" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fontSize=10;align=center;verticalAlign=middle;arcSize=20;fontSize=11;fillColor=#fde9c9;strokeColor=#c98a2b;fontColor=#4d3308;" vertex="1" parent="1"><mxGeometry x="1000" y="474" width="120" height="36" as="geometry" /></mxCell>
        <mxCell id="bm1" value="a draft is waiting for you" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=11;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="1140" y="474" width="280" height="36" as="geometry" /></mxCell>
