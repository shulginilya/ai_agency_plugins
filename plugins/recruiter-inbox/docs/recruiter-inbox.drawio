        <mxCell id="e_e1e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#4d4d4d;endArrow=blockThin;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="e1" target="e2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e_e2e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#4d4d4d;endArrow=blockThin;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="e2" target="e3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="LS" value="SHARED STATE — in the directory you run the search from" style="swimlane;html=1;startSize=36;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;rounded=1;arcSize=4;whiteSpace=wrap;fillColor=#f7f7f7;strokeColor=#999999;fontColor=#333333;swimlaneFillColor=#fcfcfc;" vertex="1" parent="1"><mxGeometry x="40" y="750" width="1800" height="160" as="geometry" /></mxCell>
        <mxCell id="s1" value="&lt;b&gt;&lt;font face=&quot;Courier New&quot;&gt;.jobhunt/profile.json&lt;/font&gt;&lt;/b&gt;&lt;br&gt;job-hunter's profile + a &lt;b&gt;replies&lt;/b&gt; section:&lt;br&gt;&lt;i&gt;&lt;font color=&quot;#666666&quot;&gt;name · send_mode · languages · availability · salary.say / disclose · shareable · never_mention · must_ask&lt;/font&gt;&lt;/i&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;align=left;spacingLeft=8;fillColor=#ffffff;strokeColor=#c2c2c2;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="60" y="800" width="420" height="90" as="geometry" /></mxCell>
        <mxCell id="s2" value="&lt;b&gt;&lt;font face=&quot;Courier New&quot;&gt;.jobhunt/inbox/threads.json&lt;/font&gt; — the reply ledger&lt;/b&gt;&lt;br&gt;threads · inbound excerpts + hashes · drafts proposed → approved · sent text · follow-up dates&lt;br&gt;&lt;i&gt;&lt;font color=&quot;#666666&quot;&gt;.gitignore = * beside it — other people's messages stay out of git&lt;/font&gt;&lt;/i&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;align=left;spacingLeft=8;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#1a1a1a;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="510" y="800" width="530" height="90" as="geometry" /></mxCell>
        <mxCell id="s3" value='&lt;b&gt;SessionStart hook · &lt;font face="Courier New"&gt;inbox_status.py&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;i&gt;&lt;font color="#666666"&gt;says who is waiting on you — silent when nobody is&lt;/font&gt;&lt;/i&gt;' style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;align=left;spacingLeft=8;fillColor=#ffffff;strokeColor=#c2c2c2;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="1070" y="800" width="360" height="90" as="geometry" /></mxCell>
        <mxCell id="s4" value='&lt;b&gt;MCP server &lt;font face="Courier New"&gt;recruiter-inbox&lt;/font&gt;&lt;/b&gt; (read-only)&lt;br&gt;&lt;font face="Courier New"&gt;assess_message · check_draft&lt;br&gt;thread_status · reply_playbook&lt;/font&gt;' style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;align=left;spacingLeft=8;fillColor=#ffffff;strokeColor=#c2c2c2;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="1460" y="800" width="365" height="90" as="geometry" /></mxCell>
        <mxCell id="e_s3s2" value="reads" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=1;strokeColor=#999999;dashed=1;endArrow=open;fontSize=10;fontColor=#666666;labelBackgroundColor=#ffffff;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="s3" target="s2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e_s1s2" value="rules" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=1;strokeColor=#999999;dashed=1;endArrow=open;fontSize=10;fontColor=#666666;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="s1" target="s2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="lg_script" value="script — deterministic, tested" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;align=left;spacingLeft=8;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#1a1a1a;fontSize=10;align=center;spacingLeft=0;" vertex="1" parent="1"><mxGeometry x="40" y="935" width="210" height="30" as="geometry" /></mxCell>
        <mxCell id="lg_hook —" value="hook — the harness enforces it" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;align=left;spacingLeft=10;fillColor=#fdeaea;strokeColor=#c0504d;fontColor=#5c1515;strokeWidth=2;strokeWidth=1;fontSize=10;align=center;spacingLeft=0;" vertex="1" parent="1"><mxGeometry x="265" y="935" width="210" height="30" as="geometry" /></mxCell>
