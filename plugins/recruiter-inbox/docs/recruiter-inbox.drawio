        <mxCell id="e_d6d7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#4d4d4d;endArrow=blockThin;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="d6" target="d7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e1" value='&lt;b&gt;&lt;font face="Courier New"&gt;threads.py stage --to scheduled&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;i&gt;&lt;font color="#666666"&gt;the call has a date&lt;/font&gt;&lt;/i&gt;' style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;align=left;spacingLeft=8;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#1a1a1a;align=center;spacingLeft=0;" vertex="1" parent="1"><mxGeometry x="1595" y="160" width="230" height="48" as="geometry" /></mxCell>
        <mxCell id="e2" value='&lt;b&gt;job-hunter&lt;/b&gt;&lt;br&gt;&lt;font face="Courier New"&gt;pipeline.py add --stage screening&lt;/font&gt;' style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;align=center;fillColor=#ffffff;strokeColor=#c2c2c2;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="1595" y="232" width="230" height="52" as="geometry" /></mxCell>
        <mxCell id="e3" value='&lt;b&gt;interview-prep&lt;/b&gt;&lt;br&gt;&lt;font face="Courier New"&gt;prep.py add · round --date&lt;/font&gt;' style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;align=center;fillColor=#ffffff;strokeColor=#c2c2c2;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="1595" y="308" width="230" height="52" as="geometry" /></mxCell>
        <mxCell id="e4" value="Proposed, not run: you agree first. The ledger keeps the conversation; the pipeline keeps the opportunity." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;align=left;spacingLeft=10;spacingRight=6;spacingTop=4;verticalAlign=top;fillColor=#f7f7f7;strokeColor=#b3b3b3;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="1595" y="386" width="230" height="76" as="geometry" /></mxCell>
        <mxCell id="e5" value='&lt;b&gt;declined / closed&lt;/b&gt;&lt;br&gt;&lt;i&gt;&lt;font color="#666666"&gt;you said no · sales · scam · two unanswered follow-ups · role filled&lt;/font&gt;&lt;/i&gt;' style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;align=center;fillColor=#ffffff;strokeColor=#c2c2c2;fontColor=#1a1a1a;fillColor=#f7f7f7;strokeColor=#b3b3b3;" vertex="1" parent="1"><mxGeometry x="1595" y="490" width="230" height="64" as="geometry" /></mxCell>
        <mxCell id="e6" value="A new message on a closed thread reopens it." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=10;fontStyle=2;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="1595" y="566" width="230" height="30" as="geometry" /></mxCell>
