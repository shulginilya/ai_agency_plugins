  </diagram>
  <diagram name="2 · The send gate">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1860" pageHeight="1180" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="t" value="recruiter-inbox — the send gate (PreToolUse hook)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=22;fontStyle=1;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1100" height="36" as="geometry" /></mxCell>
        <mxCell id="st" value="Runs before browser typing and mail sends. Pulls the text out of the call and compares it with the approved, unsent drafts in the ledger. Always exits 0; a decision is JSON on stdout (hookSpecificOutput.permissionDecision)." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="40" y="58" width="1500" height="40" as="geometry" /></mxCell>
        <mxCell id="g0" value="A browser typing call or a mail send is about to run" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;align=center;fillColor=#3c3c3c;strokeColor=#3c3c3c;fontColor=#ffffff;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="620" y="115" width="300" height="44" as="geometry" /></mxCell>
        <mxCell id="mt" value='&lt;b&gt;Matchers (hooks.json)&lt;/b&gt;&lt;br&gt;&lt;font face="Courier New"&gt;mcp__.*(claude-in-chrome|Claude_Browser).*__(computer|form_input|browser_batch)&lt;/font&gt;&lt;br&gt;&lt;font face="Courier New"&gt;mcp__.*[Gg]mail.*__(send|reply|forward).*&lt;/font&gt;&lt;br&gt;&lt;i&gt;&lt;font color="#666666"&gt;Other tools never reach the script. Creating a Gmail draft is not gated.&lt;/font&gt;&lt;/i&gt;' style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;align=left;spacingLeft=10;spacingRight=6;spacingTop=4;verticalAlign=top;fillColor=#f7f7f7;strokeColor=#b3b3b3;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="980" y="108" width="560" height="74" as="geometry" /></mxCell>
        <mxCell id="q1" value="Ledger in this&lt;br&gt;directory?" style="rhombus;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffffff;strokeColor=#7f7f7f;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="680" y="200" width="180" height="90" as="geometry" /></mxCell>
        <mxCell id="o1" value='&lt;b&gt;silent&lt;/b&gt;&lt;br&gt;&lt;i&gt;&lt;font color="#666666"&gt;not a job-search workspace&lt;/font&gt;&lt;/i&gt;' style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;align=center;fillColor=#d5efd9;strokeColor=#3f8f52;fontColor=#1d5228;" vertex="1" parent="1"><mxGeometry x="380" y="220" width="230" height="50" as="geometry" /></mxCell>
        <mxCell id="q2" value="Ledger&lt;br&gt;readable?" style="rhombus;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffffff;strokeColor=#7f7f7f;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="680" y="320" width="180" height="90" as="geometry" /></mxCell>
        <mxCell id="o2" value="&lt;b&gt;ASK&lt;/b&gt;&lt;br&gt;&lt;i&gt;&lt;font color=&quot;#666666&quot;&gt;can't check approvals&lt;/font&gt;&lt;/i&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;align=center;fillColor=#fde9c9;strokeColor=#c98a2b;fontColor=#4d3308;" vertex="1" parent="1"><mxGeometry x="930" y="340" width="230" height="50" as="geometry" /></mxCell>
        <mxCell id="q3" value="send_mode =&lt;br&gt;draft-only?" style="rhombus;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffffff;strokeColor=#7f7f7f;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="680" y="440" width="180" height="90" as="geometry" /></mxCell>
        <mxCell id="o3" value='&lt;b&gt;DENY&lt;/b&gt;&lt;br&gt;&lt;i&gt;&lt;font color="#666666"&gt;nothing typed or sent; hand the draft to the user&lt;/font&gt;&lt;/i&gt;' style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;align=center;fillColor=#f8cecc;strokeColor=#b85450;fontColor=#6b1d1b;" vertex="1" parent="1"><mxGeometry x="330" y="460" width="280" height="50" as="geometry" /></mxCell>
        <mxCell id="q4" value="Browser typing&lt;br&gt;or mail?" style="rhombus;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffffff;strokeColor=#7f7f7f;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="680" y="560" width="180" height="90" as="geometry" /></mxCell>
        <mxCell id="g_0_1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#4d4d4d;endArrow=blockThin;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="g0" target="q1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="g_1_o1" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#4d4d4d;endArrow=blockThin;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="q1" target="o1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="g_1_2" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#4d4d4d;endArrow=blockThin;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="q1" target="q2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="g_2_o2" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#4d4d4d;endArrow=blockThin;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="q2" target="o2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="g_2_3" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#4d4d4d;endArrow=blockThin;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="q2" target="q3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="g_3_o3" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#4d4d4d;endArrow=blockThin;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="q3" target="o3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="g_3_4" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#4d4d4d;endArrow=blockThin;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="q3" target="q4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="l1" value='Collect the typed text: &lt;font face="Courier New"&gt;type&lt;/font&gt; actions, form values, each &lt;font face="Courier New"&gt;browser_batch&lt;/font&gt; item' style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;align=center;fillColor=#ffffff;strokeColor=#c2c2c2;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="270" y="690" width="300" height="50" as="geometry" /></mxCell>
        <mxCell id="l2" value="40 characters&lt;br&gt;or more?" style="rhombus;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffffff;strokeColor=#7f7f7f;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="330" y="775" width="180" height="90" as="geometry" /></mxCell>
        <mxCell id="lo1" value='&lt;b&gt;silent&lt;/b&gt;&lt;br&gt;&lt;i&gt;&lt;font color="#666666"&gt;search boxes, filters&lt;/font&gt;&lt;/i&gt;' style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;align=center;fillColor=#d5efd9;strokeColor=#3f8f52;fontColor=#1d5228;" vertex="1" parent="1"><mxGeometry x="40" y="795" width="230" height="50" as="geometry" /></mxCell>
        <mxCell id="l3" value="A paragraph of an&lt;br&gt;approved, unsent&lt;br&gt;draft?" style="rhombus;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffffff;strokeColor=#7f7f7f;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="305" y="900" width="230" height="120" as="geometry" /></mxCell>
        <mxCell id="lo2" value='&lt;b&gt;silent&lt;/b&gt;&lt;br&gt;&lt;i&gt;&lt;font color="#666666"&gt;the call proceeds&lt;/font&gt;&lt;/i&gt;' style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;align=center;fillColor=#d5efd9;strokeColor=#3f8f52;fontColor=#1d5228;" vertex="1" parent="1"><mxGeometry x="40" y="935" width="230" height="50" as="geometry" /></mxCell>
        <mxCell id="lo3" value='&lt;b&gt;ASK&lt;/b&gt;&lt;br&gt;&lt;i&gt;&lt;font color="#666666"&gt;you see the text and the reason&lt;/font&gt;&lt;/i&gt;' style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;align=center;fillColor=#fde9c9;strokeColor=#c98a2b;fontColor=#4d3308;" vertex="1" parent="1"><mxGeometry x="305" y="1070" width="230" height="50" as="geometry" /></mxCell>
