        <mxCell id="g_l1_l2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#4d4d4d;endArrow=blockThin;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="l1" target="l2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="g_l2_lo1" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#4d4d4d;endArrow=blockThin;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="l2" target="lo1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="g_l2_l3" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#4d4d4d;endArrow=blockThin;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="l2" target="l3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="g_l3_lo2" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#4d4d4d;endArrow=blockThin;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="l3" target="lo2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="g_l3_lo3" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#4d4d4d;endArrow=blockThin;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="l3" target="lo3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="r1" value='Body visible?&lt;br&gt;&lt;i&gt;&lt;font color="#666666"&gt;body / htmlBody,&lt;br&gt;HTML stripped&lt;/font&gt;&lt;/i&gt;' style="rhombus;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffffff;strokeColor=#7f7f7f;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="945" y="680" width="230" height="120" as="geometry" /></mxCell>
        <mxCell id="ro1" value='&lt;b&gt;ASK&lt;/b&gt;&lt;br&gt;&lt;i&gt;&lt;font color="#666666"&gt;e.g. send by draftId only&lt;/font&gt;&lt;/i&gt;' style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;align=center;fillColor=#fde9c9;strokeColor=#c98a2b;fontColor=#4d3308;" vertex="1" parent="1"><mxGeometry x="1230" y="715" width="230" height="50" as="geometry" /></mxCell>
        <mxCell id="r2" value="Attachments?" style="rhombus;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffffff;strokeColor=#7f7f7f;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="970" y="830" width="180" height="90" as="geometry" /></mxCell>
        <mxCell id="ro2" value='&lt;b&gt;ASK&lt;/b&gt;&lt;br&gt;&lt;i&gt;&lt;font color="#666666"&gt;approval covers text, not files&lt;/font&gt;&lt;/i&gt;' style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;align=center;fillColor=#fde9c9;strokeColor=#c98a2b;fontColor=#4d3308;" vertex="1" parent="1"><mxGeometry x="1230" y="850" width="230" height="50" as="geometry" /></mxCell>
        <mxCell id="r3" value="Exactly the whole&lt;br&gt;approved draft?" style="rhombus;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffffff;strokeColor=#7f7f7f;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="945" y="950" width="230" height="110" as="geometry" /></mxCell>
        <mxCell id="ro3" value='&lt;b&gt;silent&lt;/b&gt;&lt;br&gt;&lt;i&gt;&lt;font color="#666666"&gt;the mail is sent&lt;/font&gt;&lt;/i&gt;' style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;align=center;fillColor=#d5efd9;strokeColor=#3f8f52;fontColor=#1d5228;" vertex="1" parent="1"><mxGeometry x="1230" y="980" width="230" height="50" as="geometry" /></mxCell>
        <mxCell id="ro4" value="&lt;b&gt;ASK&lt;/b&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;align=center;fillColor=#fde9c9;strokeColor=#c98a2b;fontColor=#4d3308;" vertex="1" parent="1"><mxGeometry x="970" y="1100" width="180" height="44" as="geometry" /></mxCell>
        <mxCell id="g_4_r1" value="mail" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#4d4d4d;endArrow=blockThin;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="q4" target="r1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1060" y="605" /></Array></mxGeometry></mxCell>
        <mxCell id="g_r1_ro1" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#4d4d4d;endArrow=blockThin;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="r1" target="ro1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="g_r1_r2" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#4d4d4d;endArrow=blockThin;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="r1" target="r2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="g_r2_ro2" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#4d4d4d;endArrow=blockThin;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="r2" target="ro2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="g_r2_r3" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#4d4d4d;endArrow=blockThin;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="r2" target="r3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="g_r3_ro3" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#4d4d4d;endArrow=blockThin;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="r3" target="ro3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="g_r3_ro4" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#4d4d4d;endArrow=blockThin;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="r3" target="ro4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="n1" value="&lt;b&gt;What the gate cannot see&lt;/b&gt;&lt;br&gt;• which page or thread the text lands on&lt;br&gt;• a click on Send (no text in it)&lt;br&gt;• typed text under 40 characters&lt;br&gt;&lt;br&gt;So approval is the skill's rule, and the gate is the net under it." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;align=left;spacingLeft=10;spacingRight=6;spacingTop=4;verticalAlign=top;fillColor=#f7f7f7;strokeColor=#b3b3b3;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="1540" y="560" width="290" height="124" as="geometry" /></mxCell>
        <mxCell id="n2" value="&lt;b&gt;Why ask, not deny&lt;/b&gt;&lt;br&gt;An ask puts the call in front of you with the reason, which is itself an approval moment, and never breaks a send you meant. In an unattended run it waits instead of failing." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;align=left;spacingLeft=10;spacingRight=6;spacingTop=4;verticalAlign=top;fillColor=#f7f7f7;strokeColor=#b3b3b3;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="1540" y="704" width="290" height="104" as="geometry" /></mxCell>
        <mxCell id="n3" value="&lt;b&gt;Why a paragraph passes for typing but not for mail&lt;/b&gt;&lt;br&gt;LinkedIn sends on a bare newline when Enter-to-send is on, so a reply is typed a paragraph at a time. A mail is one call, so it must be the whole approved text." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;align=left;spacingLeft=10;spacingRight=6;spacingTop=4;verticalAlign=top;fillColor=#f7f7f7;strokeColor=#b3b3b3;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="1540" y="828" width="290" height="104" as="geometry" /></mxCell>
        <mxCell id="n4" value='The approval rule lives in &lt;font face="Courier New"&gt;threads.is_approved&lt;/font&gt;; the hook imports it, so the gate cannot disagree with the ledger.' style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=10;fontStyle=2;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="1540" y="950" width="290" height="50" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram name="3 · A thread in the ledger">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1860" pageHeight="790" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="t" value="recruiter-inbox — a thread in the ledger" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=22;fontStyle=1;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1100" height="36" as="geometry" /></mxCell>
        <mxCell id="st" value="Stages move when the conversation moves. The draft inside a thread has its own states. threads.py status turns both into five buckets of things you need to do." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="40" y="58" width="1500" height="40" as="geometry" /></mxCell>
        <mxCell id="s0" value='&lt;b&gt;new&lt;/b&gt;&lt;br&gt;&lt;i&gt;&lt;font color="#666666"&gt;they wrote first&lt;/font&gt;&lt;/i&gt;' style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;align=center;fillColor=#ffffff;strokeColor=#c2c2c2;fontColor=#1a1a1a;strokeColor=#5b7fbd;" vertex="1" parent="1"><mxGeometry x="40" y="130" width="180" height="54" as="geometry" /></mxCell>
        <mxCell id="s1" value="&lt;b&gt;qualifying&lt;/b&gt;&lt;br&gt;&lt;i&gt;&lt;font color=&quot;#666666&quot;&gt;asking what's missing&lt;/font&gt;&lt;/i&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;align=center;fillColor=#ffffff;strokeColor=#c2c2c2;fontColor=#1a1a1a;strokeColor=#5b7fbd;" vertex="1" parent="1"><mxGeometry x="260" y="130" width="180" height="54" as="geometry" /></mxCell>
        <mxCell id="se1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#4d4d4d;endArrow=blockThin;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="s0" target="s1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="s2" value='&lt;b&gt;interested&lt;/b&gt;&lt;br&gt;&lt;i&gt;&lt;font color="#666666"&gt;it fits&lt;/font&gt;&lt;/i&gt;' style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;align=center;fillColor=#ffffff;strokeColor=#c2c2c2;fontColor=#1a1a1a;strokeColor=#5b7fbd;" vertex="1" parent="1"><mxGeometry x="480" y="130" width="180" height="54" as="geometry" /></mxCell>
        <mxCell id="se2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#4d4d4d;endArrow=blockThin;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="s1" target="s2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="s3" value='&lt;b&gt;scheduling&lt;/b&gt;&lt;br&gt;&lt;i&gt;&lt;font color="#666666"&gt;agreeing a time&lt;/font&gt;&lt;/i&gt;' style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;align=center;fillColor=#ffffff;strokeColor=#c2c2c2;fontColor=#1a1a1a;strokeColor=#5b7fbd;" vertex="1" parent="1"><mxGeometry x="700" y="130" width="180" height="54" as="geometry" /></mxCell>
        <mxCell id="se3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#4d4d4d;endArrow=blockThin;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="s2" target="s3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="s4" value='&lt;b&gt;scheduled&lt;/b&gt;&lt;br&gt;&lt;i&gt;&lt;font color="#666666"&gt;call has a date&lt;/font&gt;&lt;/i&gt;' style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;align=center;fillColor=#ffffff;strokeColor=#c2c2c2;fontColor=#1a1a1a;strokeColor=#5b7fbd;" vertex="1" parent="1"><mxGeometry x="920" y="130" width="180" height="54" as="geometry" /></mxCell>
        <mxCell id="se4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#4d4d4d;endArrow=blockThin;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="s3" target="s4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="hand" value='&lt;b&gt;handover&lt;/b&gt;&lt;br&gt;&lt;font face="Courier New"&gt;pipeline.py&lt;/font&gt; · &lt;font face="Courier New"&gt;prep.py&lt;/font&gt;' style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;align=center;fillColor=#ffffff;strokeColor=#c2c2c2;fontColor=#1a1a1a;fillColor=#f2e9fb;strokeColor=#8e6bbf;" vertex="1" parent="1"><mxGeometry x="1140" y="130" width="220" height="54" as="geometry" /></mxCell>
        <mxCell id="se_h" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#4d4d4d;endArrow=blockThin;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="s4" target="hand"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="dec" value='&lt;b&gt;declined&lt;/b&gt;&lt;br&gt;&lt;i&gt;&lt;font color="#666666"&gt;you said no&lt;/font&gt;&lt;/i&gt;' style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;align=center;fillColor=#ffffff;strokeColor=#c2c2c2;fontColor=#1a1a1a;fillColor=#f7f7f7;strokeColor=#b3b3b3;" vertex="1" parent="1"><mxGeometry x="480" y="250" width="180" height="54" as="geometry" /></mxCell>
        <mxCell id="clo" value='&lt;b&gt;closed&lt;/b&gt;&lt;br&gt;&lt;i&gt;&lt;font color="#666666"&gt;sales · scam · two follow-ups · filled&lt;/font&gt;&lt;/i&gt;' style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;align=center;fillColor=#ffffff;strokeColor=#c2c2c2;fontColor=#1a1a1a;fillColor=#f7f7f7;strokeColor=#b3b3b3;" vertex="1" parent="1"><mxGeometry x="670" y="250" width="240" height="54" as="geometry" /></mxCell>
        <mxCell id="se_d" value="from any stage" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=1;strokeColor=#999999;dashed=1;endArrow=open;fontSize=10;fontColor=#666666;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="s2" target="dec"><mxGeometry x="-0.1" relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="se_c" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=1;strokeColor=#999999;dashed=1;endArrow=open;fontSize=10;fontColor=#666666;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="s3" target="clo"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="se_r1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=1;strokeColor=#999999;dashed=1;endArrow=open;fontSize=10;fontColor=#666666;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="dec" target="s1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="570" y="345" /><mxPoint x="350" y="345" /></Array></mxGeometry></mxCell>
        <mxCell id="se_r2" value="they write again → reopens as qualifying" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=1;strokeColor=#999999;dashed=1;endArrow=open;fontSize=10;fontColor=#666666;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="clo" target="s1"><mxGeometry x="0.1" relative="1" as="geometry"><Array as="points"><mxPoint x="790" y="345" /><mxPoint x="350" y="345" /></Array></mxGeometry></mxCell>
        <mxCell id="LD" value="THE DRAFT INSIDE A THREAD" style="swimlane;html=1;startSize=36;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;rounded=1;arcSize=4;whiteSpace=wrap;fillColor=#eef4ff;strokeColor=#5b7fbd;fontColor=#1f3864;swimlaneFillColor=#fbfcff;" vertex="1" parent="1"><mxGeometry x="40" y="380" width="900" height="290" as="geometry" /></mxCell>
        <mxCell id="d0" value="&lt;b&gt;no draft&lt;/b&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;align=center;fillColor=#ffffff;strokeColor=#c2c2c2;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="70" y="470" width="130" height="50" as="geometry" /></mxCell>
        <mxCell id="d1" value='&lt;b&gt;proposed&lt;/b&gt;&lt;br&gt;&lt;i&gt;&lt;font color="#666666"&gt;check: clean · review · blocked&lt;/font&gt;&lt;/i&gt;' style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;align=left;spacingLeft=8;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#1a1a1a;align=center;spacingLeft=0;" vertex="1" parent="1"><mxGeometry x="270" y="460" width="200" height="70" as="geometry" /></mxCell>
        <mxCell id="d2" value='&lt;b&gt;approved&lt;/b&gt;&lt;br&gt;&lt;i&gt;&lt;font color="#666666"&gt;exact text stored&lt;/font&gt;&lt;/i&gt;' style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;align=center;fillColor=#fde9c9;strokeColor=#c98a2b;fontColor=#4d3308;" vertex="1" parent="1"><mxGeometry x="550" y="460" width="150" height="70" as="geometry" /></mxCell>
        <mxCell id="d3" value='&lt;b&gt;sent&lt;/b&gt;&lt;br&gt;&lt;i&gt;&lt;font color="#666666"&gt;added to the thread&lt;br&gt;follow-up date set&lt;/font&gt;&lt;/i&gt;' style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;align=center;fillColor=#d5efd9;strokeColor=#3f8f52;fontColor=#1d5228;" vertex="1" parent="1"><mxGeometry x="775" y="460" width="145" height="70" as="geometry" /></mxCell>
        <mxCell id="de1" value='&lt;font face="Courier New"&gt;draft&lt;/font&gt;' style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#4d4d4d;endArrow=blockThin;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="d0" target="d1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
