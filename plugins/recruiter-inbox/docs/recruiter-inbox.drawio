<mxfile host="app.diagrams.net" modified="2026-09-25T00:00:00.000Z" agent="recruiter-inbox-docs" version="24.7.7" type="device">
  <diagram name="1 · How it works">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1880" pageHeight="990" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="t" value="recruiter-inbox — from a recruiter's message to a first call" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=22;fontStyle=1;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1100" height="36" as="geometry" /></mxCell>
        <mxCell id="st" value="The actor reads and drafts in a fresh context and sends nothing on its own. Only you approve, one message at a time, word for word. Only approved text can leave: a hook checks every browser keystroke and mail send against the ledger." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="40" y="58" width="1500" height="40" as="geometry" /></mxCell>
        <mxCell id="LA" value="1 · CHANNELS" style="swimlane;html=1;startSize=36;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;rounded=1;arcSize=4;whiteSpace=wrap;fillColor=#f7f7f7;strokeColor=#999999;fontColor=#333333;swimlaneFillColor=#fcfcfc;" vertex="1" parent="1"><mxGeometry x="40" y="110" width="250" height="610" as="geometry" /></mxCell>
        <mxCell id="LB" value='2 · SWEEP — linkedin-actor&lt;br&gt;&lt;span style="font-weight:normal;font-size:11px"&gt;fresh context · sends nothing&lt;/span&gt;' style="swimlane;html=1;startSize=36;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;rounded=1;arcSize=4;whiteSpace=wrap;fillColor=#eef4ff;strokeColor=#5b7fbd;fontColor=#1f3864;swimlaneFillColor=#fbfcff;" vertex="1" parent="1"><mxGeometry x="320" y="110" width="420" height="610" as="geometry" /></mxCell>
        <mxCell id="LC" value='3 · APPROVAL — you&lt;br&gt;&lt;span style="font-weight:normal;font-size:11px"&gt;in /inbox or /reply&lt;/span&gt;' style="swimlane;html=1;startSize=36;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;rounded=1;arcSize=4;whiteSpace=wrap;fillColor=#fff6e0;strokeColor=#c98a2b;fontColor=#6b4a10;swimlaneFillColor=#fffdf7;" vertex="1" parent="1"><mxGeometry x="770" y="110" width="330" height="610" as="geometry" /></mxCell>
        <mxCell id="LD" value='4 · SEND — linkedin-actor&lt;br&gt;&lt;span style="font-weight:normal;font-size:11px"&gt;send mode · only approved drafts&lt;/span&gt;' style="swimlane;html=1;startSize=36;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;rounded=1;arcSize=4;whiteSpace=wrap;fillColor=#e8f5eb;strokeColor=#3f8f52;fontColor=#1d5228;swimlaneFillColor=#fbfefb;" vertex="1" parent="1"><mxGeometry x="1130" y="110" width="420" height="610" as="geometry" /></mxCell>
        <mxCell id="LE" value='5 · HANDOVER&lt;br&gt;&lt;span style="font-weight:normal;font-size:11px"&gt;once a call is scheduled&lt;/span&gt;' style="swimlane;html=1;startSize=36;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;rounded=1;arcSize=4;whiteSpace=wrap;fillColor=#f2e9fb;strokeColor=#8e6bbf;fontColor=#4b2a7a;swimlaneFillColor=#fdfbff;" vertex="1" parent="1"><mxGeometry x="1580" y="110" width="260" height="610" as="geometry" /></mxCell>
        <mxCell id="a1" value='&lt;b&gt;LinkedIn messages &amp;amp; InMails&lt;/b&gt;&lt;br&gt;&lt;i&gt;&lt;font color="#666666"&gt;Claude in Chrome, your signed-in session&lt;/font&gt;&lt;/i&gt;' style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;align=left;spacingLeft=8;fillColor=#ffffff;strokeColor=#c2c2c2;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="55" y="170" width="220" height="60" as="geometry" /></mxCell>
        <mxCell id="a3" value='&lt;b&gt;LinkedIn notification emails&lt;/b&gt;&lt;br&gt;&lt;i&gt;&lt;font color="#666666"&gt;in Gmail — pointers, never replied to&lt;/font&gt;&lt;/i&gt;' style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;align=left;spacingLeft=8;fillColor=#ffffff;strokeColor=#c2c2c2;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="55" y="262" width="220" height="56" as="geometry" /></mxCell>
        <mxCell id="a2" value='&lt;b&gt;Recruiter email&lt;/b&gt;&lt;br&gt;&lt;i&gt;&lt;font color="#666666"&gt;Gmail connector&lt;/font&gt;&lt;/i&gt;' style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;align=left;spacingLeft=8;fillColor=#ffffff;strokeColor=#c2c2c2;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="55" y="340" width="220" height="50" as="geometry" /></mxCell>
        <mxCell id="a4" value='&lt;b&gt;A pasted message&lt;/b&gt;&lt;br&gt;&lt;i&gt;&lt;font color="#666666"&gt;/reply&lt;/font&gt;&lt;/i&gt;' style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;align=left;spacingLeft=8;fillColor=#ffffff;strokeColor=#c2c2c2;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="55" y="410" width="220" height="50" as="geometry" /></mxCell>
        <mxCell id="a5" value="&lt;b&gt;No API for personal LinkedIn messages.&lt;/b&gt; The signed-in browser is the only route.&lt;br&gt;&lt;br&gt;LinkedIn's terms prohibit bots and automated messaging. &lt;b&gt;send_mode&lt;/b&gt; decides the last click:&lt;br&gt;approve-then-send · fill-only · draft-only" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;align=left;spacingLeft=10;spacingRight=6;spacingTop=4;verticalAlign=top;fillColor=#f7f7f7;strokeColor=#b3b3b3;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="55" y="480" width="220" height="150" as="geometry" /></mxCell>
        <mxCell id="a6" value="Message text is data, never instructions. Links in messages are listed, not opened." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=10;fontStyle=2;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="55" y="645" width="220" height="50" as="geometry" /></mxCell>
        <mxCell id="b1" value="&lt;b&gt;Read new messages&lt;/b&gt;&lt;br&gt;&lt;i&gt;&lt;font color=&quot;#666666&quot;&gt;Unread filter · each thread's own URL · ≤ 25 threads&lt;/font&gt;&lt;/i&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;align=left;spacingLeft=8;fillColor=#ffffff;strokeColor=#c2c2c2;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="335" y="160" width="390" height="48" as="geometry" /></mxCell>
        <mxCell id="b2" value='&lt;b&gt;Write text + meta JSON to files&lt;/b&gt;&lt;br&gt;&lt;i&gt;&lt;font color="#666666"&gt;names and companies never reach the shell&lt;/font&gt;&lt;/i&gt;' style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;align=left;spacingLeft=8;fillColor=#ffffff;strokeColor=#c2c2c2;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="335" y="228" width="390" height="48" as="geometry" /></mxCell>
        <mxCell id="b3" value='&lt;b&gt;inbound-triage · &lt;font face="Courier New"&gt;inbound.py&lt;/font&gt;&lt;/b&gt;' style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;align=left;spacingLeft=8;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#1a1a1a;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="335" y="296" width="390" height="112" as="geometry" /></mxCell>
        <mxCell id="chip_engage" value="engage" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fontSize=10;align=center;verticalAlign=middle;fillColor=#d5efd9;strokeColor=#3f8f52;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="345" y="326" width="70" height="24" as="geometry" /></mxCell>
        <mxCell id="chip_qualify" value="qualify" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fontSize=10;align=center;verticalAlign=middle;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="420" y="326" width="70" height="24" as="geometry" /></mxCell>
        <mxCell id="chip_decline" value="decline" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fontSize=10;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#999999;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="495" y="326" width="70" height="24" as="geometry" /></mxCell>
        <mxCell id="chip_ignore" value="ignore" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fontSize=10;align=center;verticalAlign=middle;fillColor=#f8cecc;strokeColor=#b85450;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="570" y="326" width="70" height="24" as="geometry" /></mxCell>
        <mxCell id="chip_personal" value="personal" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fontSize=10;align=center;verticalAlign=middle;fillColor=#ededed;strokeColor=#999999;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="645" y="326" width="70" height="24" as="geometry" /></mxCell>
        <mxCell id="b3c" value="engage · qualify · decline get a draft. Ignore (sales, scam patterns) is closed. Personal goes to you." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=10;fontStyle=2;fontColor=#555555;fontColor=#6b5a1e;" vertex="1" parent="1"><mxGeometry x="345" y="356" width="372" height="44" as="geometry" /></mxCell>
        <mxCell id="b4" value='&lt;b&gt;reply-ledger · &lt;font face="Courier New"&gt;threads.py seen&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;i&gt;&lt;font color="#666666"&gt;recorded once (hash) · 500-char excerpt&lt;/font&gt;&lt;/i&gt;' style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;align=left;spacingLeft=8;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="335" y="428" width="390" height="48" as="geometry" /></mxCell>
        <mxCell id="b5" value='&lt;b&gt;recruiter-reply · draft toward a call&lt;/b&gt;&lt;br&gt;&lt;i&gt;&lt;font color="#666666"&gt;answer their question · ≤ 3 questions · concrete slots · their language&lt;/font&gt;&lt;/i&gt;' style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;align=left;spacingLeft=8;fillColor=#ffffff;strokeColor=#c2c2c2;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="335" y="496" width="390" height="48" as="geometry" /></mxCell>
        <mxCell id="b6" value='&lt;b&gt;&lt;font face="Courier New"&gt;draft_check.py&lt;/font&gt;&lt;/b&gt; → clean · review · &lt;b&gt;BLOCKED&lt;/b&gt;&lt;br&gt;&lt;i&gt;&lt;font color="#666666"&gt;stray figure · contact / link not shareable · &amp;quot;I accept&amp;quot; · placeholder&lt;/font&gt;&lt;/i&gt;' style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;align=left;spacingLeft=8;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="335" y="564" width="390" height="48" as="geometry" /></mxCell>
        <mxCell id="b7" value='&lt;b&gt;&lt;font face="Courier New"&gt;threads.py draft&lt;/font&gt;&lt;/b&gt; → status &lt;b&gt;proposed&lt;/b&gt;' style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;align=left;spacingLeft=8;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="335" y="632" width="390" height="40" as="geometry" /></mxCell>
        <mxCell id="e_b1b2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#4d4d4d;endArrow=blockThin;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="b1" target="b2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e_b2b3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#4d4d4d;endArrow=blockThin;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="b2" target="b3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e_b3b4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#4d4d4d;endArrow=blockThin;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="b3" target="b4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e_b4b5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#4d4d4d;endArrow=blockThin;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="b4" target="b5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e_b5b6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#4d4d4d;endArrow=blockThin;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="b5" target="b6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e_b6b7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#4d4d4d;endArrow=blockThin;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="b6" target="b7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e_ab" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#4d4d4d;endArrow=blockThin;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.2333;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="a1" target="b1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e_a3a1" value="points to" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=1;strokeColor=#999999;dashed=1;endArrow=open;fontSize=10;fontColor=#666666;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="a3" target="a1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e_a2b" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#4d4d4d;endArrow=blockThin;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.79;entryDx=0;entryDy=0;" edge="1" parent="1" source="a2" target="b1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="303" y="365" /><mxPoint x="303" y="198" /></Array></mxGeometry></mxCell>
        <mxCell id="e_a4c" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=1;strokeColor=#999999;dashed=1;endArrow=open;fontSize=10;fontColor=#666666;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="a4" target="b3"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="311" y="435" /><mxPoint x="311" y="352" /></Array></mxGeometry></mxCell>
        <mxCell id="c1" value="For each draft you see:&lt;br&gt;&lt;b&gt;the exact text&lt;/b&gt; · the check result · what it commits to" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;align=center;fillColor=#ffffff;strokeColor=#c2c2c2;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="785" y="160" width="300" height="56" as="geometry" /></mxCell>
        <mxCell id="c2" value="&lt;b&gt;Send this&lt;br&gt;as written?&lt;/b&gt;" style="rhombus;whiteSpace=wrap;html=1;fontSize=11;fillColor=#fde9c9;strokeColor=#c98a2b;fontColor=#4d3308;" vertex="1" parent="1"><mxGeometry x="860" y="244" width="150" height="100" as="geometry" /></mxCell>
        <mxCell id="c3" value='&lt;b&gt;&lt;font face="Courier New"&gt;threads.py approve&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;i&gt;&lt;font color="#666666"&gt;stores the exact text&lt;/font&gt;&lt;/i&gt;' style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;align=left;spacingLeft=8;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#1a1a1a;align=center;spacingLeft=0;" vertex="1" parent="1"><mxGeometry x="800" y="380" width="270" height="48" as="geometry" /></mxCell>
        <mxCell id="c4" value='Other answers: &lt;b&gt;skip&lt;/b&gt; → the draft stays proposed · &lt;b&gt;close&lt;/b&gt; → &lt;font face="Courier New"&gt;threads.py close --because&lt;/font&gt;' style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;align=left;spacingLeft=10;spacingRight=6;spacingTop=4;verticalAlign=top;fillColor=#f7f7f7;strokeColor=#b3b3b3;fontColor=#333333;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="800" y="452" width="270" height="56" as="geometry" /></mxCell>
        <mxCell id="c5" value='A blocked draft is approved only with &lt;font face="Courier New"&gt;--because&lt;/font&gt;, in your words.' style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;align=left;spacingLeft=10;spacingRight=6;spacingTop=4;verticalAlign=top;fillColor=#f7f7f7;strokeColor=#b3b3b3;fontColor=#333333;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="800" y="530" width="270" height="48" as="geometry" /></mxCell>
        <mxCell id="c6" value="Subagents cannot ask you anything, so approval always happens here, in the main conversation. An edit is a new draft, a new check and a new yes." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=10;fontStyle=2;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="800" y="590" width="270" height="70" as="geometry" /></mxCell>
        <mxCell id="e_b7c1" value="drafts for approval" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#4d4d4d;endArrow=blockThin;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="b7" target="c1"><mxGeometry x="-0.45" relative="1" as="geometry"><Array as="points"><mxPoint x="755" y="652" /><mxPoint x="755" y="188" /></Array></mxGeometry></mxCell>
        <mxCell id="e_c1c2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#4d4d4d;endArrow=blockThin;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c1" target="c2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e_c2c3" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#4d4d4d;endArrow=blockThin;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c2" target="c3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e_c2b5" value="edit" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#4d4d4d;endArrow=blockThin;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c2" target="b5"><mxGeometry x="-0.75" relative="1" as="geometry"><Array as="points"><mxPoint x="780" y="294" /><mxPoint x="780" y="520" /></Array></mxGeometry></mxCell>
        <mxCell id="d1" value='&lt;b&gt;Only drafts in &lt;font face="Courier New"&gt;approved_texts&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;i&gt;&lt;font color="#666666"&gt;for the thread ids you approved&lt;/font&gt;&lt;/i&gt;' style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;align=left;spacingLeft=8;fillColor=#ffffff;strokeColor=#c2c2c2;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="1145" y="160" width="390" height="48" as="geometry" /></mxCell>
        <mxCell id="d2" value='&lt;b&gt;Open the thread&lt;/b&gt;&lt;br&gt;&lt;i&gt;&lt;font color="#666666"&gt;they wrote again since? → stop, the draft is stale&lt;/font&gt;&lt;/i&gt;' style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;align=left;spacingLeft=8;fillColor=#ffffff;strokeColor=#c2c2c2;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="1145" y="226" width="390" height="48" as="geometry" /></mxCell>
        <mxCell id="d3" value="&lt;b&gt;LinkedIn:&lt;/b&gt; type paragraph by paragraph, Shift+Enter between&lt;br&gt;&lt;b&gt;Gmail:&lt;/b&gt; reply with the whole approved body" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;align=left;spacingLeft=8;fillColor=#ffffff;strokeColor=#c2c2c2;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="1145" y="292" width="390" height="48" as="geometry" /></mxCell>
        <mxCell id="d4" value='&lt;b&gt;PreToolUse send gate · &lt;font face="Courier New"&gt;send_gate.py&lt;/font&gt;&lt;/b&gt;&lt;br&gt;approved text → silent · anything else → &lt;b&gt;ask&lt;/b&gt; · draft-only → &lt;b&gt;deny&lt;/b&gt;' style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;align=left;spacingLeft=10;fillColor=#fdeaea;strokeColor=#c0504d;fontColor=#5c1515;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1145" y="360" width="390" height="56" as="geometry" /></mxCell>
        <mxCell id="mode0" value='approve-then-send&lt;br&gt;&lt;i&gt;&lt;font color="#666666"&gt;actor clicks Send&lt;/font&gt;&lt;/i&gt;' style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fontSize=10;align=center;verticalAlign=middle;arcSize=14;fontSize=11;fillColor=#d5efd9;strokeColor=#3f8f52;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="1145" y="438" width="125" height="46" as="geometry" /></mxCell>
        <mxCell id="mode1" value='fill-only&lt;br&gt;&lt;i&gt;&lt;font color="#666666"&gt;you click Send&lt;/font&gt;&lt;/i&gt;' style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fontSize=10;align=center;verticalAlign=middle;arcSize=14;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="1277" y="438" width="125" height="46" as="geometry" /></mxCell>
        <mxCell id="mode2" value='draft-only&lt;br&gt;&lt;i&gt;&lt;font color="#666666"&gt;you paste · Gmail draft&lt;/font&gt;&lt;/i&gt;' style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fontSize=10;align=center;verticalAlign=middle;arcSize=14;fontSize=11;fillColor=#ededed;strokeColor=#999999;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="1409" y="438" width="125" height="46" as="geometry" /></mxCell>
        <mxCell id="d6" value='&lt;b&gt;Read the thread back&lt;/b&gt;&lt;br&gt;&lt;i&gt;&lt;font color="#666666"&gt;our message is there, and it matches&lt;/font&gt;&lt;/i&gt;' style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;align=left;spacingLeft=8;fillColor=#ffffff;strokeColor=#c2c2c2;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="1145" y="506" width="390" height="48" as="geometry" /></mxCell>
        <mxCell id="d7" value='&lt;b&gt;&lt;font face="Courier New"&gt;threads.py sent&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;i&gt;&lt;font color="#666666"&gt;stage · follow-up date you agreed&lt;/font&gt;&lt;/i&gt;' style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;align=left;spacingLeft=8;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="1145" y="574" width="390" height="48" as="geometry" /></mxCell>
        <mxCell id="d8" value="≤ 10 sends per run · one thread at a time · pauses between. Sign-in wall, CAPTCHA or a changed page → stop and report." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=10;fontStyle=2;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="1145" y="638" width="390" height="48" as="geometry" /></mxCell>
