        <mxCell id="bn" value="Exit 1 when any bucket has a row. The SessionStart hook prints the first four and stays silent for quiet threads alone." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=10;fontStyle=2;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="1000" y="646" width="800" height="22" as="geometry" /></mxCell>
        <mxCell id="cad" value="&lt;b&gt;Cadence&lt;/b&gt; — answer a direct question within 1 working day · slots the same day · follow up after 3–5 working days · two follow-ups, then close. Dates are proposed and written only when you agree." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;align=left;spacingLeft=10;spacingRight=6;spacingTop=4;verticalAlign=top;fillColor=#f7f7f7;strokeColor=#b3b3b3;fontColor=#333333;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="700" width="1780" height="50" as="geometry" /></mxCell>
