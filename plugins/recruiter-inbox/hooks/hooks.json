{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PLUGIN_ROOT}/scripts/inbox_status.py\""
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "mcp__.*(claude-in-chrome|Claude_Browser).*__(computer|form_input|browser_batch)",
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PLUGIN_ROOT}/scripts/send_gate.py\""
          }
        ]
      },
      {
        "matcher": "mcp__.*[Gg]mail.*__(send|reply|forward).*",
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PLUGIN_ROOT}/scripts/send_gate.py\""
          }
        ]
      }
    ]
  }
}
